{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-block" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ text_form }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if error_json %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_json }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-block" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-type">{{ entry_type }}</label>
            <div class="col-sm-10">
              <select name="type" id="input-type" class="form-control" onchange="location.href='{{ action }}&amp;type=' + this.value">
                {% for block_type in types %}
                <option value="{{ block_type.code }}"{% if block_type.code == type %} selected="selected"{% endif %}>{{ block_type.name }}</option>
                {% endfor %}
              </select>
              {% if error_type %}
              <div class="text-danger">{{ error_type }}</div>
              {% endif %}
              <div class="help-block">{{ help_type_change }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          {% if content_field_defs %}
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
            <li{% if loop.first %} class="active"{% endif %}><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% for language in languages %}
            <div class="tab-pane{% if loop.first %} active{% endif %}" id="language{{ language.language_id }}">
              {% for field in content_field_defs %}
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-{{ field.name }}{{ language.language_id }}">{{ field.label }}</label>
                <div class="col-sm-10">
                  {% if field.type == 'textarea' or field.type == 'json' %}
                  <textarea name="block_content[{{ language.language_id }}][{{ field.name }}]" placeholder="{{ field.label }}" id="input-{{ field.name }}{{ language.language_id }}" class="form-control" rows="{% if field.type == 'json' %}6{% else %}4{% endif %}">{{ block_content[language.language_id][field.name] }}</textarea>
                  {% else %}
                  <input type="text" name="block_content[{{ language.language_id }}][{{ field.name }}]" value="{{ block_content[language.language_id][field.name] }}" placeholder="{{ field.label }}" id="input-{{ field.name }}{{ language.language_id }}" class="form-control" />
                  {% endif %}
                  {% if field.help %}
                  <div class="help-block">{{ field.help }}</div>
                  {% endif %}
                </div>
              </div>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
          {% if settings_fields %}
          <fieldset>
            <legend>{{ settings_legend }}</legend>
            {% for field in settings_fields %}
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-{{ field.name }}">{{ field.label }}</label>
              <div class="col-sm-10">
                {% if field.type == 'select' %}
                <select name="settings[{{ field.name }}]" id="input-{{ field.name }}" class="form-control">
                  {% for value, label in field.options %}
                  <option value="{{ value }}"{% if value == field.value %} selected="selected"{% endif %}>{{ label }}</option>
                  {% endfor %}
                </select>
                {% elseif field.type == 'json' %}
                <textarea name="settings[{{ field.name }}]" placeholder="{{ field.label }}" id="input-{{ field.name }}" class="form-control" rows="6">{{ field.value }}</textarea>
                {% elseif field.type == 'number' %}
                <input type="number" name="settings[{{ field.name }}]" value="{{ field.value }}" placeholder="{{ field.label }}" id="input-{{ field.name }}" class="form-control"{% if field.min is not null %} min="{{ field.min }}"{% endif %} />
                {% elseif field.type == 'image' %}
                {#
                  MintCart Phase 11/25 (Media UX, MINTCART_FUNCTIONAL_SCOPE.md
                  §25) - mc-media-picker as an additional way to fill this
                  path field, alongside the plain text input (kept exactly
                  as before: a merchant who already knows the path can still
                  type/paste it directly, same "picker is additive, not a
                  replacement" shape as product_form.twig's Manufacturer/
                  Category pickers and order_form.twig's Customer picker -
                  see docs/developer/admin/asset-enqueue.md). Confirming a
                  selection writes the chosen image's catalog-relative path
                  (ModelDesignMedia::getFiles()'s `id`, the same shape
                  `model_tool_image->resize()` already expects everywhere
                  else this file's own image settings are rendered) into the
                  text input below - no change to how the value is posted/
                  normalized (ControllerDesignHomepage::normalizeFieldValue()
                  still just sees a plain string).
                #}
                <div class="input-group">
                  <input type="text" name="settings[{{ field.name }}]" value="{{ field.value }}" placeholder="{{ field.label }}" id="input-{{ field.name }}" class="form-control" data-mc-image-field-path />
                  <span class="input-group-btn">
                    <button type="button" class="btn btn-default" data-mc-action="browse-image" aria-controls="image-picker-{{ field.name }}" aria-expanded="false"><i class="fa fa-picture-o"></i> {{ text_media_picker_browse }}</button>
                  </span>
                </div>
                <div class="mc-media-picker" id="image-picker-{{ field.name }}" data-mc-image-picker hidden>
                  <div class="mc-media-picker__toolbar">
                    <input type="search" class="mc-field__control" data-mc-media-picker-search placeholder="{{ text_media_picker_search }}" aria-label="{{ text_media_picker_search }}">
                    <select class="mc-field__control" data-mc-media-picker-folder aria-label="{{ text_media_picker_search }}"></select>
                    <label class="mc-button mc-button--secondary">
                      {{ text_media_picker_upload }}
                      <input type="file" multiple hidden accept="image/*" data-mc-media-picker-upload>
                    </label>
                  </div>
                  <div class="mc-media-picker__grid" role="listbox" aria-label="{{ field.label }}" data-mc-media-picker-grid></div>
                  <p class="mc-media-picker__empty" data-mc-media-picker-empty hidden>{{ text_media_picker_empty }}</p>
                  <div class="mc-media-picker__pager">
                    <button type="button" class="mc-button mc-button--secondary" data-mc-action="media-picker-prev">{{ text_media_picker_prev }}</button>
                    <span class="mc-media-picker__page-info" data-mc-media-picker-page-info></span>
                    <button type="button" class="mc-button mc-button--secondary" data-mc-action="media-picker-next">{{ text_media_picker_next }}</button>
                  </div>
                  <div class="mc-media-picker__footer">
                    <span data-mc-media-picker-selected-count></span>
                    <button type="button" class="mc-button mc-button--secondary" data-mc-action="media-picker-delete"></button>
                    <button type="button" class="mc-button mc-button--primary" data-mc-action="media-picker-confirm">{{ text_media_picker_confirm }}</button>
                  </div>
                </div>
                {% else %}
                <input type="text" name="settings[{{ field.name }}]" value="{{ field.value }}" placeholder="{{ field.label }}" id="input-{{ field.name }}" class="form-control" />
                {% endif %}
                {% if field.help %}
                <div class="help-block">{{ field.help }}</div>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </fieldset>
          {% endif %}
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
// MintCart Phase 11/25 (Media UX, MINTCART_FUNCTIONAL_SCOPE.md §25) -
// mc-media-picker for this form's `image`-type settings fields (currently
// Hero/Text+Image's `image` field, see docs/developer/components/media-picker.md).
// Generic over however many `[data-mc-image-picker]` roots the
// settings_fields loop above renders (today: at most one visible at a
// time, since only one block type's fields render per page load) rather
// than hardcoding one field name - same "no mc-drawer/mc-modal needed,
// plain hidden-attribute toggle" shape as sale/order_form.twig's Customer
// field McEntityPicker (neither mc-drawer nor mc-modal work on this
// Bootstrap-3 legacy screen - components.min.css deliberately excludes
// the Bootstrap 5 JS/CSS they depend on, see
// docs/developer/admin/asset-enqueue.md).
//
// Known, documented limitation: ModelDesignMedia::getFiles() lists
// subdirectories inline in the same grid as images (type: 'directory'),
// since the backend was built for a general-purpose browse/upload/delete
// API, not specifically for this single-image-field consumer. This
// picker does not let a directory cell be "entered" (clicking one only
// toggles its (inert) selection) - folder navigation here is limited to
// the top-level folder <select> fetchFolders() already populates. Picking
// a directory cell and confirming does nothing (no path is applied),
// rather than silently writing a folder path into an image field.
(function () {
	if (!window.MintCart || !window.MintCart.createMediaPicker) {
		return;
	}

	function fetchJson(url, options) {
		return fetch(url, options).then(function (response) {
			return response.json();
		});
	}

	document.querySelectorAll('[data-mc-image-picker]').forEach(function (pickerRoot) {
		var wrapper = pickerRoot.previousElementSibling;
		var pathInput = wrapper ? wrapper.querySelector('[data-mc-image-field-path]') : null;
		var browseButton = wrapper ? wrapper.querySelector('[data-mc-action="browse-image"]') : null;
		var folderSelect = pickerRoot.querySelector('[data-mc-media-picker-folder]');

		if (!pathInput || !browseButton) {
			return;
		}

		var picker = window.MintCart.createMediaPicker(pickerRoot, {
			multiple: false,
			fetchItems: function (options) {
				var params = new URLSearchParams({
					folder: options.folder || '',
					query: options.query || '',
					page: options.page,
					pageSize: options.pageSize
				});

				return fetchJson('index.php?route=design/media/list&user_token={{ user_token }}&' + params, { signal: options.signal });
			},
			fetchFolders: function () {
				return fetchJson('index.php?route=design/media/folders&user_token={{ user_token }}').then(function (json) {
					return json.folders || [];
				});
			},
			uploadFiles: function (files) {
				var formData = new FormData();

				files.forEach(function (file) {
					formData.append('file[]', file);
				});

				var folder = folderSelect ? folderSelect.value : '';

				return fetch('index.php?route=design/media/upload&user_token={{ user_token }}&folder=' + encodeURIComponent(folder), {
					method: 'POST',
					body: formData
				}).then(function (response) {
					return response.json();
				});
			},
			deleteItems: function (items) {
				var params = new URLSearchParams();

				items.forEach(function (item) {
					params.append('paths[]', item.id);
				});

				return fetch('index.php?route=design/media/delete&user_token={{ user_token }}', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: params.toString()
				}).then(function (response) {
					return response.json();
				});
			},
			onConfirm: function (selected) {
				var item = selected[0];

				if (item && item.type !== 'directory') {
					pathInput.value = item.id;
				}

				picker.clear();
				pickerRoot.hidden = true;
				browseButton.setAttribute('aria-expanded', 'false');
				browseButton.focus();
			}
		});

		browseButton.addEventListener('click', function () {
			var opening = pickerRoot.hidden;

			pickerRoot.hidden = !pickerRoot.hidden;
			browseButton.setAttribute('aria-expanded', String(opening));

			if (opening) {
				picker.refresh();
			}
		});
	});
})();
//--></script>
{{ footer }}
