{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-block" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ text_form }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-block" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-type">{{ entry_type }}</label>
            <div class="col-sm-10">
              <select name="type" id="input-type" class="form-control">
                {% for block_type in types %}
                <option value="{{ block_type.code }}"{% if block_type.code == type %} selected="selected"{% endif %}>{{ block_type.name }}</option>
                {% endfor %}
              </select>
              {% if error_type %}
              <div class="text-danger">{{ error_type }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
            <li{% if loop.first %} class="active"{% endif %}><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% for language in languages %}
            <div class="tab-pane{% if loop.first %} active{% endif %}" id="language{{ language.language_id }}">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-title{{ language.language_id }}">{{ entry_title }}</label>
                <div class="col-sm-10">
                  <input type="text" name="block_content[{{ language.language_id }}][title]" value="{{ block_content[language.language_id] ? block_content[language.language_id].title }}" placeholder="{{ entry_title }}" id="input-title{{ language.language_id }}" class="form-control" />
                </div>
              </div>
            </div>
            {% endfor %}
          </div>
          <fieldset>
            <legend>{{ text_settings_products }}</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-category-id">{{ entry_category_id }}</label>
              <div class="col-sm-10">
                <input type="number" name="settings[category_id]" value="{{ category_id }}" placeholder="{{ entry_category_id }}" id="input-category-id" class="form-control" />
                <div class="help-block">{{ help_category_id }}</div>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-limit">{{ entry_limit }}</label>
              <div class="col-sm-10">
                <input type="number" name="settings[limit]" value="{{ limit }}" placeholder="{{ entry_limit }}" id="input-limit" class="form-control" min="1" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-sort">{{ entry_sort }}</label>
              <div class="col-sm-10">
                <select name="settings[sort]" id="input-sort" class="form-control">
                  <option value="p.date_added"{% if sort == 'p.date_added' %} selected="selected"{% endif %}>Date Added</option>
                  <option value="p.viewed"{% if sort == 'p.viewed' %} selected="selected"{% endif %}>Viewed</option>
                  <option value="p.price"{% if sort == 'p.price' %} selected="selected"{% endif %}>Price</option>
                  <option value="pd.name"{% if sort == 'pd.name' %} selected="selected"{% endif %}>Name</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-order">{{ entry_order }}</label>
              <div class="col-sm-10">
                <select name="settings[order]" id="input-order" class="form-control">
                  <option value="ASC"{% if order == 'ASC' %} selected="selected"{% endif %}>ASC</option>
                  <option value="DESC"{% if order == 'DESC' %} selected="selected"{% endif %}>DESC</option>
                </select>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
