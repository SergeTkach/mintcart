{%- import _self as m -%}
{%- set t = {
  'drag': text_item_drag,
  'remove': text_item_remove,
  'more': text_item_more,
  'add': button_add_item,
  'empty': text_items_empty,
  'pick': text_image_pick,
  'placeholder': placeholder
} -%}
{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-block" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ text_form }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if error_json %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_json }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-block" class="form-horizontal" data-mc-items-form>
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-type">{{ entry_type }}</label>
            <div class="col-sm-10">
              <select name="type" id="input-type" class="form-control" onchange="location.href='{{ action }}&amp;type=' + this.value">
                {% for block_type in types %}
                <option value="{{ block_type.code }}"{% if block_type.code == type %} selected="selected"{% endif %}>{{ block_type.name }}</option>
                {% endfor %}
              </select>
              {% if error_type %}
              <div class="text-danger">{{ error_type }}</div>
              {% endif %}
              <div class="help-block">{{ help_type_change }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          {% if content_field_defs %}
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
            <li{% if loop.first %} class="active"{% endif %}><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% for language in languages %}
            <div class="tab-pane{% if loop.first %} active{% endif %}" id="language{{ language.language_id }}">
              {% for field in content_field_defs %}
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-{{ field.name }}{{ language.language_id }}">{{ field.label }}</label>
                <div class="col-sm-10">
                  {% if field.type == 'textarea' %}
                  <textarea name="block_content[{{ language.language_id }}][{{ field.name }}]" placeholder="{{ field.label|e }}" id="input-{{ field.name }}{{ language.language_id }}" class="form-control" rows="4">{{ block_content[language.language_id][field.name]|e }}</textarea>
                  {% else %}
                  <input type="text" name="block_content[{{ language.language_id }}][{{ field.name }}]" value="{{ block_content[language.language_id][field.name]|e }}" placeholder="{{ field.label|e }}" id="input-{{ field.name }}{{ language.language_id }}" class="form-control" />
                  {% endif %}
                  {% if field.help %}
                  <div class="help-block">{{ field.help }}</div>
                  {% endif %}
                </div>
              </div>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
          {% if settings_fields %}
          <fieldset>
            <legend>{{ settings_legend }}</legend>
            {% for field in settings_fields %}
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-{{ field.name }}">{{ field.label }}</label>
              <div class="col-sm-10">
                {% if field.type == 'select' %}
                <select name="settings[{{ field.name }}]" id="input-{{ field.name }}" class="form-control">
                  {% for value, label in field.options %}
                  <option value="{{ value }}"{% if value == field.value %} selected="selected"{% endif %}>{{ label }}</option>
                  {% endfor %}
                </select>
                {% elseif field.type == 'number' %}
                <input type="number" name="settings[{{ field.name }}]" value="{{ field.value|e }}" placeholder="{{ field.label|e }}" id="input-{{ field.name }}" class="form-control"{% if field.min is not null %} min="{{ field.min }}"{% endif %} />
                {% elseif field.type == 'image' %}
                <div class="mc-items__image">
                  <a href="" id="thumb-{{ field.name }}" data-toggle="image" class="img-thumbnail" title="{{ text_image_pick }}"><img src="{{ field.thumb }}" alt="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="settings[{{ field.name }}]" value="{{ field.value|e }}" id="input-{{ field.name }}" />
                </div>
                {% else %}
                <input type="text" name="settings[{{ field.name }}]" value="{{ field.value|e }}" placeholder="{{ field.label|e }}" id="input-{{ field.name }}" class="form-control" />
                {% endif %}
                {% if field.help %}
                <div class="help-block">{{ field.help }}</div>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </fieldset>
          {% endif %}

          {% for list in lists %}
          <fieldset class="mc-items" data-mc-items data-list="{{ list.name }}" data-max="{{ list.max }}"{% if list.show_when %} data-mc-show-setting="{{ list.show_when[0] }}" data-mc-show-value="{{ list.show_when[1] }}"{% endif %}>
            <legend>{{ list.label }}</legend>
            {% if languages|length > 1 %}
            <ul class="nav nav-tabs mc-items__langs">
              {% for language in languages %}
              <li{% if loop.first %} class="active"{% endif %}><a href="#" data-mc-items-lang="{{ language.language_id }}"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
              {% endfor %}
            </ul>
            {% endif %}
            <div class="mc-items__list" data-mc-items-list>
              {% for row in list.rows %}
              {{ m.item_row(list, row, loop.index0, languages, t) }}
              {% endfor %}
            </div>
            <p class="mc-items__empty text-muted" data-mc-items-empty>{{ t.empty }}</p>
            <button type="button" class="btn btn-primary btn-sm" data-mc-items-add><i class="fa fa-plus-circle"></i> {{ t.add }}</button>
            <template data-mc-items-template>{{ m.item_row(list, list.blank, '__UID__', languages, t) }}</template>
          </fieldset>
          {% endfor %}

          {% if ai_languages_count > 1 %}
          <div class="mc-ai" data-mc-ai-translate data-languages="{{ ai_languages|e }}" data-text-confirm="{{ text_ai_confirm|e }}" data-text-invalid="{{ text_ai_invalid|e }}" data-text-notes="{{ text_ai_notes|e }}">
            <div class="mc-ai__head">
              <span class="mc-ai__title"><i class="fa fa-magic"></i> {{ text_ai_title }}</span>
              <span>
                <button type="button" class="btn btn-default btn-xs" data-mc-ai-copy><i class="fa fa-clipboard"></i> {{ button_ai_copy }}</button>
                <button type="button" class="btn btn-default btn-xs" data-mc-ai-refresh><i class="fa fa-refresh"></i> {{ button_ai_refresh }}</button>
                <button type="button" class="btn btn-xs mc-ai__apply" data-mc-ai-apply><i class="fa fa-level-up"></i> {{ button_ai_apply }}</button>
              </span>
            </div>
            <div class="mc-ai__body">
              <p class="mc-ai__hint">{{ text_ai_hint }} <em>{{ text_ai_prompt }}</em></p>
              <textarea class="form-control mc-ai__json" rows="12" data-mc-ai-json spellcheck="false"></textarea>
            </div>
          </div>
          {% endif %}
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
{#
  One row of a block's list (a slide, banner, benefit, ...). Used for the existing rows and,
  with uid "__UID__" and empty values, for the <template> the "Add" button clones.
  Left to right: drag handle, the fields shared by every language (picture, links, colour),
  the texts (one pane per language, switched by the tabs above the list), row actions.
#}
{% macro item_row(list, row, uid, languages, t) %}
<div class="mc-items__row" data-mc-items-row data-uid="{{ uid }}">
  <div class="mc-items__handle">
    <i class="fa fa-arrows mc-items__grip" data-mc-items-handle title="{{ t.drag }}" aria-hidden="true"></i>
  </div>
  {% for f in list.images %}
  <div class="mc-items__col mc-items__col--image">
    <label class="mc-items__label">{{ f.label }}</label>
    <div class="mc-items__image">
      <a href="" id="thumb-{{ list.name }}-{{ uid }}-{{ f.name }}" data-toggle="image" class="img-thumbnail" title="{{ t.pick }}"><img src="{{ row.thumbs[f.name] }}" alt="" data-placeholder="{{ t.placeholder }}" /></a>
      <input type="hidden" name="settings[{{ list.name }}][{{ uid }}][{{ f.name }}]" value="{{ row.settings[f.name]|e }}" id="input-{{ list.name }}-{{ uid }}-{{ f.name }}" />
    </div>
  </div>
  {% endfor %}
  {% for column, fields in list.columns %}
  <div class="mc-items__col mc-items__col--{{ column }}">
    {% for f in fields %}
    <div class="mc-items__field{% if f.extra %} mc-items__field--extra{% endif %}" data-mc-items-field{% if f.extra %} data-mc-items-extra hidden{% endif %}>
      <label class="mc-items__label">{{ f.label }}</label>
      {% if f.scope == 'settings' %}
        {% if f.type == 'select' %}
        <select name="settings[{{ list.name }}][{{ uid }}][{{ f.name }}]" class="form-control">
          {% for value, label in f.options %}
          <option value="{{ value }}"{% if value == row.settings[f.name] %} selected="selected"{% endif %}>{{ label }}</option>
          {% endfor %}
        </select>
        {% else %}
        <input type="text" name="settings[{{ list.name }}][{{ uid }}][{{ f.name }}]" value="{{ row.settings[f.name]|e }}" placeholder="{{ f.placeholder|e }}" class="form-control" />
        {% endif %}
      {% else %}
        {% for language in languages %}
        <div data-mc-items-lang-pane="{{ language.language_id }}"{% if not loop.first %} hidden{% endif %}>
          {% if f.type == 'textarea' %}
          <textarea name="block_content[{{ language.language_id }}][{{ list.name }}][{{ uid }}][{{ f.name }}]" rows="2" class="form-control">{{ row.content[language.language_id][f.name]|e }}</textarea>
          {% else %}
          <input type="text" name="block_content[{{ language.language_id }}][{{ list.name }}][{{ uid }}][{{ f.name }}]" value="{{ row.content[language.language_id][f.name]|e }}" class="form-control" />
          {% endif %}
        </div>
        {% endfor %}
      {% endif %}
      {% if f.help %}<div class="mc-items__help">{{ f.help }}</div>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  <div class="mc-items__col mc-items__col--actions">
    <button type="button" class="btn btn-xs btn-danger mc-items__remove" data-mc-items-remove title="{{ t.remove }}" aria-label="{{ t.remove }}"><i class="fa fa-close"></i></button>
    {% if list.has_extra %}
    <button type="button" class="mc-items__more{% if row.extra_filled %} mc-items__more--filled{% endif %}" data-mc-items-more><i class="fa fa-sliders"></i> {{ t.more }}</button>
    {% endif %}
  </div>
</div>
{% endmacro %}
