{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-block" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ text_form }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if error_json %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_json }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-block" class="form-horizontal">
          <div class="form-group required">
            <label class="col-sm-2 control-label" for="input-type">{{ entry_type }}</label>
            <div class="col-sm-10">
              <select name="type" id="input-type" class="form-control" onchange="location.href='{{ action }}&amp;type=' + this.value">
                {% for block_type in types %}
                <option value="{{ block_type.code }}"{% if block_type.code == type %} selected="selected"{% endif %}>{{ block_type.name }}</option>
                {% endfor %}
              </select>
              {% if error_type %}
              <div class="text-danger">{{ error_type }}</div>
              {% endif %}
              <div class="help-block">{{ help_type_change }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                <option value="1" selected="selected">{{ text_enabled }}</option>
                <option value="0">{{ text_disabled }}</option>
                {% else %}
                <option value="1">{{ text_enabled }}</option>
                <option value="0" selected="selected">{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
          {% if content_field_defs %}
          <ul class="nav nav-tabs" id="language">
            {% for language in languages %}
            <li{% if loop.first %} class="active"{% endif %}><a href="#language{{ language.language_id }}" data-toggle="tab"><img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}</a></li>
            {% endfor %}
          </ul>
          <div class="tab-content">
            {% for language in languages %}
            <div class="tab-pane{% if loop.first %} active{% endif %}" id="language{{ language.language_id }}">
              {% for field in content_field_defs %}
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-{{ field.name }}{{ language.language_id }}">{{ field.label }}</label>
                <div class="col-sm-10">
                  {% if field.type == 'textarea' or field.type == 'json' %}
                  <textarea name="block_content[{{ language.language_id }}][{{ field.name }}]" placeholder="{{ field.label }}" id="input-{{ field.name }}{{ language.language_id }}" class="form-control" rows="{% if field.type == 'json' %}6{% else %}4{% endif %}">{{ block_content[language.language_id][field.name] }}</textarea>
                  {% else %}
                  <input type="text" name="block_content[{{ language.language_id }}][{{ field.name }}]" value="{{ block_content[language.language_id][field.name] }}" placeholder="{{ field.label }}" id="input-{{ field.name }}{{ language.language_id }}" class="form-control" />
                  {% endif %}
                  {% if field.help %}
                  <div class="help-block">{{ field.help }}</div>
                  {% endif %}
                </div>
              </div>
              {% endfor %}
            </div>
            {% endfor %}
          </div>
          {% endif %}
          {% if settings_fields %}
          <fieldset>
            <legend>{{ settings_legend }}</legend>
            {% for field in settings_fields %}
            <div class="form-group">
              <label class="col-sm-2 control-label" for="input-{{ field.name }}">{{ field.label }}</label>
              <div class="col-sm-10">
                {% if field.type == 'select' %}
                <select name="settings[{{ field.name }}]" id="input-{{ field.name }}" class="form-control">
                  {% for value, label in field.options %}
                  <option value="{{ value }}"{% if value == field.value %} selected="selected"{% endif %}>{{ label }}</option>
                  {% endfor %}
                </select>
                {% elseif field.type == 'json' %}
                <textarea name="settings[{{ field.name }}]" placeholder="{{ field.label }}" id="input-{{ field.name }}" class="form-control" rows="6">{{ field.value }}</textarea>
                {% elseif field.type == 'number' %}
                <input type="number" name="settings[{{ field.name }}]" value="{{ field.value }}" placeholder="{{ field.label }}" id="input-{{ field.name }}" class="form-control"{% if field.min is not null %} min="{{ field.min }}"{% endif %} />
                {% else %}
                <input type="text" name="settings[{{ field.name }}]" value="{{ field.value }}" placeholder="{{ field.label }}" id="input-{{ field.name }}" class="form-control" />
                {% endif %}
                {% if field.help %}
                <div class="help-block">{{ field.help }}</div>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </fieldset>
          {% endif %}
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
