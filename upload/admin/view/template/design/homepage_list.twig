{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ add }}" data-toggle="tooltip" title="{{ text_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <button type="submit" form="form-homepage" formaction="{{ delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="return confirm('{{ text_confirm }}');"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
      </div>
      <div class="panel-body">
        {% if blocks %}
        <p class="text-muted">
          <input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" />
          {{ text_drag_hint }}
        </p>
        {% endif %}
        <form method="post" id="form-homepage">
          {% if blocks %}
          <ul class="mc-sortable" data-mc-sortable data-mc-sortable-handle id="homepage-block-list">
            {% for block in blocks %}
            <li class="mc-sortable__item" data-mc-sortable-item="{{ block.block_id }}">
              <button type="button" class="mc-sortable__handle" data-mc-action="sortable-handle" aria-label="{{ text_drag_handle }}">⠿</button>
              {% if block.block_id in selected %}
              <input type="checkbox" name="selected[]" value="{{ block.block_id }}" checked="checked" />
              {% else %}
              <input type="checkbox" name="selected[]" value="{{ block.block_id }}" />
              {% endif %}
              <span class="mc-sortable__label">
                <strong>{{ block.type }}</strong> — {{ block.title }}
                <span class="label label-default">{{ block.status }}</span>
              </span>
              <input type="hidden" name="order[{{ block.block_id }}]" value="{{ loop.index0 }}" />
              <div class="mc-sortable__controls">
                <button type="button" class="mc-sortable__move" data-mc-action="sortable-move-up" aria-label="{{ text_move_up }}">↑</button>
                <button type="button" class="mc-sortable__move" data-mc-action="sortable-move-down" aria-label="{{ text_move_down }}">↓</button>
                <a href="{{ block.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary btn-sm"><i class="fa fa-pencil"></i></a>
              </div>
            </li>
            {% endfor %}
          </ul>
          <button type="submit" formaction="{{ save_order }}" class="btn btn-default"><i class="fa fa-sort"></i> {{ button_save_order }}</button>
          {% else %}
          <p class="text-muted">{{ text_no_results }}</p>
          {% endif %}
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
<script>
/**
 * Persists McSortable's reorder (assets/src/js/components/sortable.js,
 * auto-initialized from admin.min.js - enqueued by
 * ControllerDesignHomepage::enqueueMintAssets(), docs/developer/admin/asset-enqueue.md)
 * into the same per-row order[<block_id>] hidden inputs saveOrder() already
 * reads - that controller method's contract did not need to change for
 * this. Plain non-module inline <script>, same convention every admin
 * Twig template already follows (docs/developer/admin/asset-enqueue.md's
 * "Calling createEntityPicker/createMediaPicker from a legacy template").
 *
 * Known interim limitation: mc-sortable's own pointer/touch drag only
 * initializes if admin.min.js's init calls run after this list's markup
 * exists in the DOM - see assets/src/js/admin.js's own "Boot timing"
 * comment if present, or docs/developer/components/sortable.md. Until
 * that's true, the keyboard-usable move-up/move-down buttons below still
 * work (their listener is delegated on `document`, independent of when the
 * list markup renders), so reordering stays possible either way.
 */
(function () {
    'use strict';

    var list = document.getElementById('homepage-block-list');

    if (!list) {
        return;
    }

    list.addEventListener('mc:sortable:reorder', function (event) {
        event.detail.order.forEach(function (blockId, index) {
            var input = list.querySelector('input[name="order[' + blockId + ']"]');

            if (input) {
                input.value = index;
            }
        });
    });
})();
</script>
