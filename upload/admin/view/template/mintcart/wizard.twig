<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ heading_title }}</title>
<link rel="stylesheet" href="{{ asset_base }}assets/dist/css/index.min.css" />
</head>
<body class="mc-wizard">
{#
  Setup Wizard - a standalone onboarding page (no legacy admin chrome).
  Component: assets/src/css/components/wizard.css,
  docs/developer/onboarding/setup-wizard.md.
#}
{% macro actions(prev_step_url, button_back, label) %}
  <div class="mc-wizard__actions">
    {% if prev_step_url %}<a class="mc-button mc-button--ghost" href="{{ prev_step_url }}">{{ button_back }}</a>{% endif %}
    <button type="submit" class="mc-button mc-button--primary mc-wizard__next">{{ label }}</button>
  </div>
{% endmacro %}
{% import _self as wizard %}

<header class="mc-wizard__topbar">
  <div class="container mc-wizard__topbar-inner">
    <img class="mc-wizard__brand" src="{{ brand_logo }}" alt="MintCart" width="140" height="48" />
    <span class="mc-wizard__topbar-title">{{ heading_title }}</span>
    {% if step and step != 'ready' %}<a class="mc-wizard__skip" href="{{ skip_wizard }}">{{ button_skip_wizard }}</a>{% endif %}
  </div>
</header>

<main class="container mc-wizard__layout">
  <div class="row g-4 g-lg-5">
    <div class="col-lg-4">
      <nav class="mc-wizard__nav" aria-label="{{ text_steps }}">
        <div class="mc-wizard__progress-head">
          <span>{{ text_step_of|format(step_number, step_total) }}</span>
          <span>{{ text_progress|format(progress_percent) }}</span>
        </div>
        <div class="mc-wizard__progress" role="progressbar" aria-label="{{ text_steps }}" aria-valuenow="{{ progress_percent }}" aria-valuemin="0" aria-valuemax="100" style="--mc-wizard-progress: {{ progress_percent }}%">
          <span class="mc-wizard__progress-bar"></span>
        </div>

        <ol class="mc-wizard__steps">
          {% for nav_step in nav_steps %}
          <li class="mc-wizard__step{% if nav_step.completed and not nav_step.current %} is-done{% endif %}"{% if nav_step.current %} aria-current="step"{% endif %}>
            {% if nav_step.reachable and not nav_step.current %}
            <a class="mc-wizard__step-link" href="{{ action }}&amp;step={{ nav_step.code }}">
            {% else %}
            <span class="mc-wizard__step-link">
            {% endif %}
              <span class="mc-wizard__step-marker" aria-hidden="true">{% if nav_step.completed and not nav_step.current %}&#10003;{% else %}{{ loop.index }}{% endif %}</span>
              <span class="mc-wizard__step-label">{{ nav_step.label }}</span>
            {% if nav_step.reachable and not nav_step.current %}</a>{% else %}</span>{% endif %}
          </li>
          {% endfor %}
        </ol>
      </nav>
    </div>

    <div class="col-lg-8">
      <section class="mc-wizard__panel">

        {% if error.warning %}
        <div class="mc-alert mc-alert--danger mb-4" role="alert">
          <div class="mc-alert__body">
            <p class="mc-alert__message">{{ error.warning }}</p>
          </div>
        </div>
        {% endif %}

        {% if step == 'welcome' %}
        <h1 class="mc-wizard__title">{{ welcome_title }}</h1>
        <p class="mc-wizard__lead">{{ welcome_text }}</p>
        <form action="{{ action }}" method="post">
          <input type="hidden" name="step" value="welcome" />
          {{ wizard.actions('', button_back, button_get_started) }}
        </form>
        {% endif %}

        {% if step == 'store' %}
        <h1 class="mc-wizard__title">{{ store_title }}</h1>
        <p class="mc-wizard__lead">{{ store_text }}</p>
        <form action="{{ action }}" method="post" enctype="multipart/form-data" novalidate>
          <input type="hidden" name="step" value="store" />

          <div class="row g-3">
            <div class="col-md-6">
              <div class="mc-field {% if error.name %}has-error{% endif %}">
                <label class="mc-field__label" for="input-config-name">{{ entry_name }}</label>
                <input type="text" id="input-config-name" name="config_name" value="{{ config_name }}" class="mc-field__control" {% if error.name %}aria-invalid="true" aria-describedby="error-config-name"{% endif %} />
                {% if error.name %}<p class="mc-field__error" id="error-config-name" role="alert">{{ error.name }}</p>{% endif %}
              </div>
            </div>
            <div class="col-md-6">
              <div class="mc-field {% if error.email %}has-error{% endif %}">
                <label class="mc-field__label" for="input-config-email">{{ entry_email }}</label>
                <input type="email" id="input-config-email" name="config_email" value="{{ config_email }}" class="mc-field__control" {% if error.email %}aria-invalid="true" aria-describedby="error-config-email"{% endif %} />
                {% if error.email %}<p class="mc-field__error" id="error-config-email" role="alert">{{ error.email }}</p>{% endif %}
              </div>
            </div>
            <div class="col-md-6">
              <div class="mc-field {% if error.telephone %}has-error{% endif %}">
                <label class="mc-field__label" for="input-config-telephone">{{ entry_telephone }}</label>
                <input type="tel" id="input-config-telephone" name="config_telephone" value="{{ config_telephone }}" class="mc-field__control" {% if error.telephone %}aria-invalid="true" aria-describedby="error-config-telephone"{% endif %} />
                {% if error.telephone %}<p class="mc-field__error" id="error-config-telephone" role="alert">{{ error.telephone }}</p>{% endif %}
              </div>
            </div>
            <div class="col-12">
              <div class="mc-field {% if error.address %}has-error{% endif %}">
                <label class="mc-field__label" for="input-config-address">{{ entry_address }}</label>
                <textarea id="input-config-address" name="config_address" rows="3" class="mc-field__control" {% if error.address %}aria-invalid="true" aria-describedby="error-config-address"{% endif %}>{{ config_address }}</textarea>
                {% if error.address %}<p class="mc-field__error" id="error-config-address" role="alert">{{ error.address }}</p>{% endif %}
              </div>
            </div>
            <div class="col-12">
              <div class="mc-field {% if error.logo %}has-error{% endif %}">
                <label class="mc-field__label" for="input-config-logo">{{ entry_logo }}</label>
                <div class="mc-wizard__logo">
                  {% if current_logo %}<img class="mc-wizard__logo-preview" src="{{ current_logo }}" alt="" />{% endif %}
                  <input type="file" id="input-config-logo" name="logo" accept="image/svg+xml,.svg,image/png,image/jpeg,image/gif,image/webp" class="mc-field__control" aria-describedby="help-config-logo{% if error.logo %} error-config-logo{% endif %}" />
                </div>
                <p class="mc-field__help" id="help-config-logo">{{ help_logo }}</p>
                {% if error.logo %}<p class="mc-field__error" id="error-config-logo" role="alert">{{ error.logo }}</p>{% endif %}
              </div>
            </div>
          </div>

          {{ wizard.actions(prev_step_url, button_back, button_continue) }}
        </form>
        {% endif %}

        {% if step == 'contacts' %}
        <h1 class="mc-wizard__title">{{ contacts_title }}</h1>
        <p class="mc-wizard__lead">{{ contacts_text }}</p>
        <form action="{{ action }}" method="post" novalidate>
          <input type="hidden" name="step" value="contacts" />

          <div class="row g-3">
            {% for network in [
              {code: 'facebook', label: entry_social_facebook, placeholder: 'https://facebook.com/yourstore', value: social_facebook, error: error.social_facebook},
              {code: 'instagram', label: entry_social_instagram, placeholder: 'https://instagram.com/yourstore', value: social_instagram, error: error.social_instagram},
              {code: 'twitter', label: entry_social_twitter, placeholder: 'https://x.com/yourstore', value: social_twitter, error: error.social_twitter},
              {code: 'youtube', label: entry_social_youtube, placeholder: 'https://youtube.com/@yourstore', value: social_youtube, error: error.social_youtube}
            ] %}
            <div class="col-md-6">
              <div class="mc-field {% if network.error %}has-error{% endif %}">
                <label class="mc-field__label" for="input-social-{{ network.code }}">{{ network.label }}</label>
                <input type="url" id="input-social-{{ network.code }}" name="social_{{ network.code }}" value="{{ network.value }}" placeholder="{{ network.placeholder }}" class="mc-field__control" {% if network.error %}aria-invalid="true" aria-describedby="error-social-{{ network.code }}"{% endif %} />
                {% if network.error %}<p class="mc-field__error" id="error-social-{{ network.code }}" role="alert">{{ network.error }}</p>{% endif %}
              </div>
            </div>
            {% endfor %}
          </div>

          {{ wizard.actions(prev_step_url, button_back, button_continue) }}
        </form>
        {% endif %}

        {% if step == 'language_currency' %}
        <h1 class="mc-wizard__title">{{ language_currency_title }}</h1>
        <p class="mc-wizard__lead">{{ language_currency_text }}</p>
        {% if notice %}
        <div class="mc-alert mc-alert--{{ notice_type }} mb-4" role="status">
          <div class="mc-alert__body">
            <p class="mc-alert__message">{{ notice }}</p>
          </div>
        </div>
        {% endif %}
        <form action="{{ action }}" method="post" novalidate>
          <input type="hidden" name="step" value="language_currency" />

          <div class="row g-3">
            <div class="col-md-6">
              <div class="mc-field {% if error.language %}has-error{% endif %}">
                <label class="mc-field__label" for="input-config-language">{{ entry_language }}</label>
                <select id="input-config-language" name="config_language" class="mc-field__control" {% if error.language %}aria-invalid="true" aria-describedby="error-config-language"{% endif %}>
                  {% for language in languages %}
                  <option value="{{ language.code }}" {% if language.code == config_language %}selected="selected"{% endif %}>{{ language.name }}</option>
                  {% endfor %}
                </select>
                {% if error.language %}<p class="mc-field__error" id="error-config-language" role="alert">{{ error.language }}</p>{% endif %}
                {% if available_languages %}
                <div class="d-flex gap-2 mt-2">
                  <input type="text" name="add_language_code" form="mc-add-language-form" class="mc-field__control" list="mc-language-options" placeholder="{{ text_add_language }}" aria-label="{{ text_add_language }}" autocomplete="off" />
                  <datalist id="mc-language-options">
                    {% for code, label in available_languages %}
                    <option value="{{ label }}"></option>
                    {% endfor %}
                  </datalist>
                  <button type="submit" form="mc-add-language-form" class="mc-button mc-button--secondary" title="{{ button_add_language }}" aria-label="{{ button_add_language }}">+</button>
                </div>
                {% endif %}
              </div>
            </div>
            <div class="col-md-6">
              <div class="mc-field {% if error.currency %}has-error{% endif %}">
                <label class="mc-field__label" for="input-config-currency">{{ entry_currency }}</label>
                <select id="input-config-currency" name="config_currency" class="mc-field__control" {% if error.currency %}aria-invalid="true" aria-describedby="error-config-currency"{% endif %}>
                  {% for currency in currencies %}
                  <option value="{{ currency.code }}" {% if currency.code == config_currency %}selected="selected"{% endif %}>{{ currency.title }} ({{ currency.code }})</option>
                  {% endfor %}
                </select>
                {% if error.currency %}<p class="mc-field__error" id="error-config-currency" role="alert">{{ error.currency }}</p>{% endif %}
                {% if available_currencies %}
                <div class="d-flex gap-2 mt-2">
                  <input type="text" name="add_currency_code" form="mc-add-currency-form" class="mc-field__control" list="mc-currency-options" placeholder="{{ text_add_currency }}" aria-label="{{ text_add_currency }}" autocomplete="off" />
                  <datalist id="mc-currency-options">
                    {% for code, label in available_currencies %}
                    <option value="{{ label }}"></option>
                    {% endfor %}
                  </datalist>
                  <button type="submit" form="mc-add-currency-form" class="mc-button mc-button--secondary" title="{{ button_add_currency }}" aria-label="{{ button_add_currency }}">+</button>
                </div>
                {% endif %}
              </div>
            </div>
          </div>

          {{ wizard.actions(prev_step_url, button_back, button_continue) }}
        </form>
        <form id="mc-add-currency-form" action="{{ add_currency_action }}" method="post"></form>
        <form id="mc-add-language-form" action="{{ add_language_action }}" method="post"></form>
        {% endif %}

        {% if step == 'delivery' or step == 'payment' %}
        {% set methods = step == 'delivery' ? shipping_extensions : payment_extensions %}
        <h1 class="mc-wizard__title">{{ step == 'delivery' ? delivery_title : payment_title }}</h1>
        <p class="mc-wizard__lead">{{ step == 'delivery' ? delivery_text : payment_text }}</p>

        {% set any_enabled = methods|filter(m => m.enabled)|length > 0 %}
        {% if not any_enabled %}
        <div class="mc-alert mc-alert--warning mb-4" role="status">
          <div class="mc-alert__body">
            <p class="mc-alert__message">{{ step == 'delivery' ? warning_delivery_none : warning_payment_none }}</p>
          </div>
        </div>
        {% endif %}

        {% if methods is empty %}
        <p class="mc-wizard__empty">{{ step == 'delivery' ? text_delivery_empty : text_payment_empty }}</p>
        {% else %}
        <ul class="mc-wizard__options">
          {% for extension in methods %}
          <li class="mc-wizard__option{% if extension.enabled %} is-on{% endif %}">
            <span class="mc-wizard__option-name">{{ extension.name }}</span>
            <span class="mc-badge{% if extension.enabled %} mc-badge--success{% endif %}">{{ extension.enabled ? text_enabled : text_disabled }}</span>
            <form action="{{ step == 'delivery' ? toggle_delivery : toggle_payment }}" method="post">
              <input type="hidden" name="code" value="{{ extension.code }}" />
              <button type="submit" class="mc-button mc-button--{{ extension.enabled ? 'ghost' : 'secondary' }} mc-button--sm">{{ extension.enabled ? button_disable : button_enable }}</button>
            </form>
          </li>
          {% endfor %}
        </ul>
        {% endif %}

        <a href="{{ step == 'delivery' ? manage_delivery : manage_payment }}" class="mc-wizard__more">{{ step == 'delivery' ? button_manage_delivery : button_manage_payment }}</a>

        <form action="{{ action }}" method="post">
          <input type="hidden" name="step" value="{{ step }}" />
          {{ wizard.actions(prev_step_url, button_back, button_continue) }}
        </form>
        {% endif %}

        {% if step == 'design' %}
        <h1 class="mc-wizard__title">{{ design_title }}</h1>
        <form action="{{ action }}" method="post" novalidate>
          <input type="hidden" name="step" value="design" />
          {% if presets %}
          <fieldset>
            <legend class="mc-wizard__lead">{{ design_text }}</legend>
            <div class="mc-wizard__choices">
              {% for preset in presets %}
              <label class="mc-wizard__choice mc-wizard__choice--{{ preset.code }}">
                <input type="radio" class="mc-wizard__choice-input" name="mintcart_design_preset" value="{{ preset.code }}"{% if preset.code == selected_preset %} checked{% endif %} />
                <span class="mc-wizard__swatch" aria-hidden="true"><span></span><span></span><span></span></span>
                <span class="mc-wizard__choice-label">{{ preset.label }}</span>
              </label>
              {% endfor %}
            </div>
            {% if error.preset %}<p class="mc-field__error" role="alert">{{ error.preset }}</p>{% endif %}
          </fieldset>
          <a class="mc-wizard__more" href="{{ store_preview }}" target="_blank" rel="noopener">{{ design_preview }}</a>
          {% else %}
          <p class="mc-wizard__empty">{{ design_no_presets }}</p>
          {% endif %}
          {{ wizard.actions(prev_step_url, button_back, button_continue) }}
        </form>
        {% endif %}

        {% if step == 'first_product' %}
        <h1 class="mc-wizard__title">{{ first_product_title }}</h1>
        <p class="mc-wizard__lead">{{ first_product_text }}</p>
        <form action="{{ action }}" method="post" novalidate>
          <input type="hidden" name="step" value="first_product" />
          <input type="hidden" name="first_product_action" value="add" />

          <div class="row g-3">
            <div class="col-12">
              <div class="mc-field {% if error.product_name %}has-error{% endif %}">
                <label class="mc-field__label" for="input-product-name">{{ entry_product_name }}</label>
                <input type="text" id="input-product-name" name="product_name" value="{{ product_name }}" class="mc-field__control" {% if error.product_name %}aria-invalid="true" aria-describedby="error-product-name"{% endif %} />
                {% if error.product_name %}<p class="mc-field__error" id="error-product-name" role="alert">{{ error.product_name }}</p>{% endif %}
              </div>
            </div>
            <div class="col-md-6">
              <div class="mc-field {% if error.price %}has-error{% endif %}">
                <label class="mc-field__label" for="input-price">{{ entry_price }}</label>
                <input type="text" inputmode="decimal" id="input-price" name="price" value="{{ price }}" class="mc-field__control" {% if error.price %}aria-invalid="true" aria-describedby="error-price"{% endif %} />
                {% if error.price %}<p class="mc-field__error" id="error-price" role="alert">{{ error.price }}</p>{% endif %}
              </div>
            </div>
            <div class="col-md-6">
              <div class="mc-field">
                <label class="mc-field__label" for="input-quantity">{{ entry_quantity }}</label>
                <input type="number" min="0" id="input-quantity" name="quantity" value="{{ quantity }}" placeholder="100" class="mc-field__control" />
              </div>
            </div>
            <div class="col-12">
              <div class="mc-field">
                <label class="mc-field__label" for="input-description">{{ entry_description }}</label>
                <textarea id="input-description" name="description" rows="4" class="mc-field__control">{{ description }}</textarea>
              </div>
            </div>
          </div>

          {{ wizard.actions(prev_step_url, button_back, button_add_product) }}
        </form>
        <form action="{{ action }}" method="post" class="mc-wizard__secondary">
          <input type="hidden" name="step" value="first_product" />
          <input type="hidden" name="first_product_action" value="skip" />
          <button type="submit" class="mc-wizard__link-button">{{ button_skip }}</button>
        </form>
        {% endif %}

        {% if step == 'ready' %}
        <h1 class="mc-wizard__title">{{ readiness_title }}</h1>
        <p class="mc-wizard__lead">{{ readiness_text }}</p>

        <div class="mc-wizard__readiness">
          <span class="mc-wizard__readiness-value">{{ readiness.percent }}%</span>
          <div class="mc-wizard__progress" role="progressbar" aria-label="{{ readiness_title }}" aria-valuenow="{{ readiness.percent }}" aria-valuemin="0" aria-valuemax="100" style="--mc-wizard-progress: {{ readiness.percent }}%">
            <span class="mc-wizard__progress-bar"></span>
          </div>
        </div>

        <ul class="mc-wizard__options">
          {% for check in readiness.checks %}
          <li class="mc-wizard__option{% if check.complete %} is-on{% endif %}">
            <span class="mc-wizard__option-name">{{ check.label }}</span>
            <span class="mc-badge{% if check.complete %} mc-badge--success{% endif %}">{{ check.complete ? text_check_done : text_check_pending }}</span>
          </li>
          {% endfor %}
        </ul>

        <form action="{{ action }}" method="post">
          <input type="hidden" name="step" value="ready" />
          {{ wizard.actions(prev_step_url, button_back, button_finish_setup) }}
        </form>
        {% endif %}

        {% if is_ready %}
        <h1 class="mc-wizard__title">{{ ready_title }}</h1>
        <p class="mc-wizard__lead">{{ ready_text }}</p>
        <div class="mc-wizard__actions">
          <a href="{{ dashboard }}" class="mc-button mc-button--primary mc-wizard__next">{{ button_go_to_dashboard }}</a>
        </div>
        {% endif %}

      </section>
    </div>
  </div>
</main>
</body>
</html>
