{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ manage }}" data-toggle="tooltip" title="{{ text_manage }}" class="btn btn-default"><i class="fa fa-cog"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-truck"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        {% if extensions %}
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ text_column_name }}</td>
                <td class="text-left">{{ text_column_status }}</td>
                <td class="text-right">&nbsp;</td>
              </tr>
            </thead>
            <tbody>
              {% for extension in extensions %}
              <tr>
                <td class="text-left">{{ extension.name }}</td>
                <td class="text-left">
                  {% if extension.enabled %}
                  <span class="label label-success">{{ text_enabled }}</span>
                  {% else %}
                  <span class="label label-default">{{ text_disabled }}</span>
                  {% endif %}
                </td>
                <td class="text-right">
                  {% if extension.fields %}
                  <button type="button" class="btn btn-default btn-sm" data-toggle="collapse" data-target="#method-{{ extension.code }}" title="{{ text_settings }}"><i class="fa fa-sliders"></i></button>
                  {% else %}
                  <a href="{{ extension.edit }}" data-toggle="tooltip" title="{{ text_configure }}" class="btn btn-default btn-sm"><i class="fa fa-pencil"></i></a>
                  {% endif %}
                  <form method="post" action="{{ action_toggle }}" style="display: inline-block;">
                    <input type="hidden" name="code" value="{{ extension.code }}" />
                    {% if extension.enabled %}
                    <button type="submit" data-toggle="tooltip" title="{{ text_disable }}" class="btn btn-warning btn-sm"><i class="fa fa-toggle-off"></i></button>
                    {% else %}
                    <button type="submit" data-toggle="tooltip" title="{{ text_enable }}" class="btn btn-success btn-sm"><i class="fa fa-toggle-on"></i></button>
                    {% endif %}
                  </form>
                </td>
              </tr>
              {% if extension.fields %}
              <tr id="method-{{ extension.code }}" class="collapse">
                <td colspan="3">
                  <form action="{{ action_save }}" method="post" class="form-horizontal" data-method-form>
                    <input type="hidden" name="code" value="{{ extension.code }}" />
                    {% for field in extension.fields %}
                    <div class="form-group">
                      <label class="col-sm-3 control-label" for="field-{{ extension.code }}-{{ field.key }}">{{ field.label }}</label>
                      <div class="col-sm-4">
                        {% if field.type == 'select' %}
                        <select id="field-{{ extension.code }}-{{ field.key }}" name="field[{{ field.key }}]" class="form-control">
                          {% for option_value, option_label in field.options %}
                          <option value="{{ option_value }}"{% if option_value == field.value %} selected{% endif %}>{{ option_label }}</option>
                          {% endfor %}
                        </select>
                        {% elseif field.type == 'text' %}
                        <input type="text" id="field-{{ extension.code }}-{{ field.key }}" name="field[{{ field.key }}]" value="{{ field.value }}" class="form-control" autocomplete="off" />
                        {% else %}
                        <input type="text" inputmode="decimal" id="field-{{ extension.code }}-{{ field.key }}" name="field[{{ field.key }}]" value="{{ field.value }}" class="form-control" />
                        {% endif %}
                        <div class="text-danger" data-error="{{ field.key }}"></div>
                      </div>
                    </div>
                    {% endfor %}
                    <div class="form-group">
                      <div class="col-sm-offset-3 col-sm-9">
                        <button type="submit" class="btn btn-primary btn-sm">{{ text_save }}</button>
                        <a href="{{ extension.edit }}" class="btn btn-link btn-sm">{{ text_more }}</a>
                        <span data-status></span>
                      </div>
                    </div>
                  </form>
                </td>
              </tr>
              {% endif %}
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% else %}
        <div class="text-center">{{ text_empty }} <a href="{{ manage }}">{{ text_manage }}</a></div>
        {% endif %}
      </div>
    </div>
    {% if available %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-plus-circle"></i> {{ text_add }}</h3>
      </div>
      <div class="panel-body">
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <tbody>
              {% for extension in available %}
              <tr>
                <td class="text-left">{{ extension.name }}</td>
                <td class="text-right">
                  <form method="post" action="{{ action_install }}" style="display: inline-block;">
                    <input type="hidden" name="code" value="{{ extension.code }}" />
                    <button type="submit" class="btn btn-success btn-sm"><i class="fa fa-plus-circle"></i> {{ text_install }}</button>
                  </form>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
</div>
<script>
$('[data-method-form]').on('submit', function (event) {
  event.preventDefault();
  var $form = $(this);
  $form.find('[data-error]').text('');
  $form.find('[data-status]').text('');
  $.post($form.attr('action'), $form.serialize(), null, 'json').done(function (json) {
    $.each(json.errors || {}, function (key, message) {
      $form.find('[data-error="' + key + '"]').text(message);
    });
    $form.find('[data-status]').attr('class', json.ok ? 'text-success' : 'text-danger').text(json.message);
  });
});
</script>
{{ footer }}
