{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-mintcart-business-contacts" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" id="form-mintcart-business-contacts" class="form-horizontal">
          <fieldset>
            <legend>{{ text_contact_details }}</legend>
            <div class="form-group required{% if error_config_telephone %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-telephone">{{ entry_telephone }}</label>
              <div class="col-sm-10">
                <input type="text" name="config_telephone" value="{{ config_telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" />
                {% if error_config_telephone %}
                <div class="text-danger">{{ error_config_telephone }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required{% if error_config_email %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-email">{{ entry_email }}</label>
              <div class="col-sm-10">
                <input type="text" name="config_email" value="{{ config_email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
                {% if error_config_email %}
                <div class="text-danger">{{ error_config_email }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group required{% if error_config_address %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-address">{{ entry_address }}</label>
              <div class="col-sm-10">
                <textarea name="config_address" placeholder="{{ entry_address }}" id="input-address" rows="3" class="form-control">{{ config_address }}</textarea>
                {% if error_config_address %}
                <div class="text-danger">{{ error_config_address }}</div>
                {% endif %}
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_social_links }}</legend>
            <div class="form-group{% if error_social_facebook %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-social-facebook">{{ entry_social_facebook }}</label>
              <div class="col-sm-10">
                <input type="url" name="social_facebook" value="{{ social_facebook }}" placeholder="https://facebook.com/yourstore" id="input-social-facebook" class="form-control" />
                {% if error_social_facebook %}
                <div class="text-danger">{{ error_social_facebook }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group{% if error_social_instagram %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-social-instagram">{{ entry_social_instagram }}</label>
              <div class="col-sm-10">
                <input type="url" name="social_instagram" value="{{ social_instagram }}" placeholder="https://instagram.com/yourstore" id="input-social-instagram" class="form-control" />
                {% if error_social_instagram %}
                <div class="text-danger">{{ error_social_instagram }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group{% if error_social_twitter %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-social-twitter">{{ entry_social_twitter }}</label>
              <div class="col-sm-10">
                <input type="url" name="social_twitter" value="{{ social_twitter }}" placeholder="https://x.com/yourstore" id="input-social-twitter" class="form-control" />
                {% if error_social_twitter %}
                <div class="text-danger">{{ error_social_twitter }}</div>
                {% endif %}
              </div>
            </div>
            <div class="form-group{% if error_social_youtube %} has-error{% endif %}">
              <label class="col-sm-2 control-label" for="input-social-youtube">{{ entry_social_youtube }}</label>
              <div class="col-sm-10">
                <input type="url" name="social_youtube" value="{{ social_youtube }}" placeholder="https://youtube.com/@yourstore" id="input-social-youtube" class="form-control" />
                {% if error_social_youtube %}
                <div class="text-danger">{{ error_social_youtube }}</div>
                {% endif %}
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
