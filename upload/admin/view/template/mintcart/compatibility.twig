{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-mintcart-compatibility" data-toggle="tooltip" title="{{ button_check }}" class="btn btn-primary"><i class="fa fa-check"></i> {{ button_check }}</button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-plug"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <p>{{ text_intro }}</p>
        <form action="{{ action }}" method="post" id="form-mintcart-compatibility" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-xml">{{ entry_xml }}</label>
            <div class="col-sm-10">
              <textarea name="xml" id="input-xml" rows="10" class="form-control">{{ xml }}</textarea>
            </div>
          </div>
        </form>
      </div>
    </div>
    {% if manifest %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-info-circle"></i> {{ manifest.name }} ({{ manifest.code }}, {{ manifest.version }})</h3>
      </div>
      <div class="panel-body">
        {% if report.files %}
        <div class="table-responsive">
          <table class="table table-bordered table-hover">
            <thead>
              <tr>
                <td class="text-left">{{ column_path }}</td>
                <td class="text-left">{{ column_type }}</td>
                <td class="text-left">{{ column_flags }}</td>
              </tr>
            </thead>
            <tbody>
              {% for file in report.files %}
              <tr>
                <td class="text-left">{{ file.path }}</td>
                <td class="text-left">
                  {% if file.is_controller %}{{ text_type_controller }}{% elseif file.is_template %}{{ text_type_template }}{% else %}{{ text_type_other }}{% endif %}
                </td>
                <td class="text-left">
                  {% if file.is_theme %}<span class="label label-info">{{ text_flag_theme }}</span>{% endif %}
                  {% if file.path in report.potential_conflicts %}<span class="label label-danger">{{ text_flag_conflict }}</span>{% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p>
          <strong>{{ text_summary }}:</strong>
          {{ report.summary.file_count }} {{ text_summary_files }},
          {{ report.summary.controller_count }} {{ text_summary_controllers }},
          {{ report.summary.template_count }} {{ text_summary_templates }},
          {{ report.summary.theme_count }} {{ text_summary_theme }},
          {{ report.summary.bootstrap3_count }} {{ text_summary_bootstrap3 }},
          {{ report.summary.conflict_count }} {{ text_summary_conflicts }}
        </p>
        {% if report.bootstrap3_assumptions %}
        <div class="alert alert-warning">
          <strong>{{ text_bootstrap3_heading }}</strong>
          <ul>
            {% for item in report.bootstrap3_assumptions %}
            <li>{{ item.path }}: {{ item.markers|join(', ') }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% if report.potential_conflicts %}
        <div class="alert alert-warning">
          <strong>{{ text_conflicts_heading }}</strong>
          <ul>
            {% for path in report.potential_conflicts %}
            <li>{{ path }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        {% else %}
        <p class="text-muted">{{ text_no_results }}</p>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</div>
{{ footer }}
