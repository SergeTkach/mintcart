{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-hdd-o"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <p>{{ text_intro }}</p>

        <table class="table table-bordered">
          <tbody>
            <tr>
              <td class="text-left" style="width: 25%;">{{ text_current }}</td>
              <td class="text-left"><code>{{ storage }}</code></td>
            </tr>
          </tbody>
        </table>

        <h4>{{ text_move_title }}</h4>
        <p class="text-muted">{{ text_move_help }}</p>

        <form action="{{ action }}" method="post" class="form-horizontal" data-mc-ajax-form>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_location }}</label>
            <div class="col-sm-10">
              {% for location in locations %}
              <div class="radio">
                <label>
                  <input type="radio" name="field[location]" value="{{ location.key }}"{% if location.key == current %} checked{% endif %} />
                  <strong>{{ location.name }}</strong>{% if location.key == current %} <span class="label label-success">{{ text_current_mark }}</span>{% endif %}
                  <br /><code>{{ location.path }}</code>
                </label>
              </div>
              {% endfor %}
              <p class="help-block text-danger" data-mc-ajax-form-error="location" role="alert" hidden></p>
            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
              <button type="submit" class="btn btn-primary"><i class="fa fa-arrows"></i> {{ button_move }}</button>
              <span data-mc-ajax-form-status role="status"></span>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
