{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-shipping" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-shipping" class="form-horizontal">
          <div class="form-group{% if error_api_key %} has-error{% endif %}">
            <label class="col-sm-2 control-label" for="input-api-key">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_mc_novaposhta_api_key" value="{{ shipping_mc_novaposhta_api_key }}" id="input-api-key" class="form-control" autocomplete="off" />
              <div class="help-block">{{ help_api_key }}</div>
              {% if error_api_key %}
              <div class="text-danger">{{ error_api_key }}</div>
              {% endif %}
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ entry_directory }}</label>
            <div class="col-sm-10">
              <p class="form-control-static" id="directory-status">{{ directory_status }}</p>
              <button type="button" class="btn btn-default" id="button-sync" data-loading-text="{{ text_loading }}"><i class="fa fa-refresh"></i> {{ button_sync }}</button>
              <div class="help-block">{{ help_directory }}</div>
              <div class="text-danger" id="sync-error"></div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-free-from">{{ entry_free_from }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_mc_novaposhta_free_from" value="{{ shipping_mc_novaposhta_free_from }}" id="input-free-from" class="form-control" />
              <div class="help-block">{{ help_free_from }}</div>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="shipping_mc_novaposhta_status" id="input-status" class="form-control">
                <option value="1"{% if shipping_mc_novaposhta_status %} selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not shipping_mc_novaposhta_status %} selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="shipping_mc_novaposhta_sort_order" value="{{ shipping_mc_novaposhta_sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
// Refills the local directory page by page: cities, branches, then "finish" drops what Nova Poshta no longer lists.
$('#button-sync').on('click', function () {
  var $button = $(this), $status = $('#directory-status'), $error = $('#sync-error');
  var idle = $button.html(), batch = Math.floor(Date.now() / 1000);
  var steps = ['cities', 'warehouses', 'finish'], total = 0;

  $error.text('');
  $button.prop('disabled', true).text($button.data('loading-text'));

  function fail() {
    $error.text('{{ error_api }}');
    $button.prop('disabled', false).html(idle);
  }

  function run(index, page) {
    if (index >= steps.length) {
      return;
    }

    $.post('{{ sync_url }}', { step: steps[index], page: page, batch: batch }, null, 'json').done(function (result) {
      if (!result.ok) {
        $error.text(result.message);
        $button.prop('disabled', false).html(idle);
        return;
      }

      if (steps[index] === 'finish') {
        $status.text(result.message);
        $button.prop('disabled', false).html(idle);
        return;
      }

      total += result.count;
      $status.text(steps[index] + ': ' + total);

      if (result.last) {
        total = 0;
        run(index + 1, 1);
      } else {
        run(index, page + 1);
      }
    }).fail(fail);
  }

  run(0, 1);
});
</script>
{{ footer }}
