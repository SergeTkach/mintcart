{#
    Checkout fields of a carrier with pickup points (Nova Poshta, Ukrposhta): a searchable
    city picker, then a searchable picker of the city's branches (number and address).
    Behaviour: catalog/view/javascript/mintcart/carrier-points.js (vanilla, no Select2).
    The carrier supplies the delivery city and address itself, so the checkout hides its
    own city / address fields while one of these options is chosen.
#}
<div class="mc-points" data-mc-points data-method="{{ method }}" data-cities-url="{{ cities_url }}" data-points-url="{{ points_url }}" data-text-choose="{{ text_choose }}" data-text-loading="{{ text_loading }}" data-text-none="{{ text_none }}" data-text-type-more="{{ hint_city }}">
  <div class="mc-field mc-points__city" data-mc-checkout-field="{{ prefix }}_city">
    <span class="mc-field__label" id="mc-points-city-label">{{ label_city }}</span>
    <div class="mc-picker" data-mc-picker="city" data-remote>
      <button type="button" class="mc-field__control mc-picker__toggle" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="mc-points-city-label"><span class="mc-picker__label" data-mc-picker-label>{{ city_text ? city_text : text_choose }}</span></button>
      <div class="mc-picker__panel" hidden>
        <input type="search" class="mc-field__control mc-picker__search" placeholder="{{ hint_city }}" aria-label="{{ label_city }}" autocomplete="off">
        <ul class="mc-picker__list" role="listbox" aria-labelledby="mc-points-city-label"></ul>
      </div>
    </div>
    <input type="hidden" name="{{ prefix }}_city" value="{{ city_ref }}" data-mc-points-city-ref>
    <p class="mc-field__error" role="alert" hidden></p>
  </div>
  {% if method == 'courier' %}
  <div class="mc-field" data-mc-checkout-field="{{ prefix }}_courier">
    <label class="mc-field__label" for="mc-points-courier">{{ label_courier }}</label>
    <input type="text" id="mc-points-courier" name="{{ prefix }}_courier" class="mc-field__control" value="{{ courier }}">
    <p class="mc-field__error" role="alert" hidden></p>
  </div>
  {% else %}
  <div class="mc-field" data-mc-checkout-field="{{ prefix }}_point">
    <span class="mc-field__label" id="mc-points-point-label">{{ label_point }}</span>
    <div class="mc-picker" data-mc-picker="point" data-disabled>
      <button type="button" class="mc-field__control mc-picker__toggle" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="mc-points-point-label" disabled><span class="mc-picker__label" data-mc-picker-label>{{ text_choose }}</span></button>
      <div class="mc-picker__panel" hidden>
        <input type="search" class="mc-field__control mc-picker__search" placeholder="{{ label_point }}" aria-label="{{ label_point }}" autocomplete="off">
        <ul class="mc-picker__list" role="listbox" aria-labelledby="mc-points-point-label"></ul>
      </div>
    </div>
    <input type="hidden" name="{{ prefix }}_point" value="{{ point_id }}" data-mc-points-point-ref>
    <p class="mc-field__error" role="alert" hidden></p>
  </div>
  {% endif %}
  <script src="{{ script }}"></script>
</div>
