{{ header }}
{% if mc_schema_breadcrumb %}
<script type="application/ld+json">{{ mc_schema_breadcrumb|raw }}</script>
{% endif %}
<div class="container py-4">
    <nav class="mc-breadcrumb mb-4" aria-label="Breadcrumb">
        <ol class="mc-breadcrumb__list">
            {% for breadcrumb in breadcrumbs %}
                {% if not loop.last %}
                    <li class="mc-breadcrumb__item">
                        <a class="mc-breadcrumb__link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                    </li>
                {% else %}
                    <li class="mc-breadcrumb__item" aria-current="page">{{ breadcrumb.text }}</li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    <div class="row g-4">
        {{ column_left }}

        {% if column_left and column_right %}
            {% set content_class = 'col-lg-6' %}
        {% elseif column_left or column_right %}
            {% set content_class = 'col-lg-9' %}
        {% else %}
            {% set content_class = 'col-12' %}
        {% endif %}

        <div class="{{ content_class }}">
            {{ content_top }}

            <h1 class="mb-4">{{ heading_title }}</h1>

            {% if thumb or description_intro %}
                <div class="d-flex flex-column flex-sm-row align-items-sm-start gap-3 gap-sm-4 mb-4">
                    {% if thumb %}
                        <img src="{{ thumb }}" alt="{{ heading_title }}" class="flex-shrink-0 rounded"{% if thumb_width %} width="{{ thumb_width }}"{% endif %}{% if thumb_height %} height="{{ thumb_height }}"{% endif %}>
                    {% endif %}
                    {% if description_intro %}
                        <div class="mc-prose flex-grow-1">{{ description_intro }}</div>
                    {% endif %}
                </div>
            {% endif %}

            {% if categories %}
                <div class="mc-subcategories mb-4">
                    <p class="mc-subcategories__title">{{ text_refine }}</p>
                    <ul class="mc-subcategories__list">
                        {% for category in categories %}
                            <li><a class="mc-subcategories__link" href="{{ category.href }}">{{ category.name }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
            {% endif %}

            {% if product_cards %}
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                    <a href="{{ compare }}" id="compare-total" class="mc-button mc-button--secondary mc-button--sm">{{ text_compare }}</a>

                    <div class="d-flex flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-nowrap" for="input-sort">{{ text_sort }}</label>
                            <select id="input-sort" class="form-select form-select-sm" onchange="location = this.value;">
                                {% for item in sorts %}
                                    <option value="{{ item.href }}"{% if item.value == '%s-%s'|format(sort, order) %} selected{% endif %}>{{ item.text }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <label class="form-label mb-0 text-nowrap" for="input-limit">{{ text_limit }}</label>
                            <select id="input-limit" class="form-select form-select-sm" onchange="location = this.value;">
                                {% for item in limits %}
                                    <option value="{{ item.href }}"{% if item.value == limit %} selected{% endif %}>{{ item.text }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    {% for product_card in product_cards %}
                        <div class="col-6 col-lg-3">
                            {{ product_card }}
                        </div>
                    {% endfor %}
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                    <div>{{ pagination }}</div>
                    <div>{{ results }}</div>
                </div>
            {% endif %}

            {% if not categories and not product_cards %}
                <p>{{ text_empty }}</p>
                <div class="text-end">
                    <a href="{{ continue }}" class="mc-button mc-button--primary">{{ button_continue }}</a>
                </div>
            {% endif %}

            {% if description_rest %}
                <div class="mc-prose mt-5">{{ description_rest }}</div>
            {% endif %}

            {{ content_bottom }}
        </div>

        {{ column_right }}
    </div>
</div>
{{ footer }}
