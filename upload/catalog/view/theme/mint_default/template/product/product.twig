{{ header }}
{% if mc_schema_product %}
<script type="application/ld+json">{{ mc_schema_product|raw }}</script>
{% endif %}
{% if mc_schema_breadcrumb %}
<script type="application/ld+json">{{ mc_schema_breadcrumb|raw }}</script>
{% endif %}
<div class="container py-4">
    <nav class="mc-breadcrumb mb-4" aria-label="Breadcrumb">
        <ol class="mc-breadcrumb__list">
            {% for breadcrumb in breadcrumbs %}
                {% if not loop.last %}
                    <li class="mc-breadcrumb__item">
                        <a class="mc-breadcrumb__link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                    </li>
                {% else %}
                    <li class="mc-breadcrumb__item" aria-current="page">{{ breadcrumb.text }}</li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    <div class="row g-4">
        {{ column_left }}

        {% if column_left and column_right %}
            {% set content_class = 'col-lg-6' %}
        {% elseif column_left or column_right %}
            {% set content_class = 'col-lg-9' %}
        {% else %}
            {% set content_class = 'col-12' %}
        {% endif %}

        <div class="{{ content_class }}">
            {{ content_top }}

            {# Section nav: in-page links that also work without JS. They
               carry the full page URL because OpenCart's <base href> would
               turn a bare "#id" into a link to the home page; section-nav.js
               scrolls in place and highlights the section in view. #}
            {% set section_url = (breadcrumbs|last).href %}
            <nav class="mc-section-nav mb-4" data-mc-section-nav aria-label="{{ text_section_nav }}">
                <ul class="mc-section-nav__list">
                    <li><a class="mc-section-nav__link" href="{{ section_url }}#product-overview" aria-current="true">{{ tab_overview }}</a></li>
                    {% if description %}
                        <li><a class="mc-section-nav__link" href="{{ section_url }}#product-description">{{ tab_description }}</a></li>
                    {% endif %}
                    {% if attribute_groups %}
                        <li><a class="mc-section-nav__link" href="{{ section_url }}#product-specs">{{ tab_attribute }}</a></li>
                    {% endif %}
                    {% if review_status %}
                        <li><a class="mc-section-nav__link" href="{{ section_url }}#product-reviews">{{ tab_review }}</a></li>
                    {% endif %}
                    {% if product_cards %}
                        <li><a class="mc-section-nav__link" href="{{ section_url }}#product-related">{{ text_related }}</a></li>
                    {% endif %}
                </ul>
            </nav>

            <div class="row g-4 mb-4" id="product-overview" data-mc-section data-mc-product-form>
                <div class="col-md-5">
                    <div class="mc-product-gallery">
                        <a href="{{ popup }}" class="mc-product-gallery__main-link" data-mc-action="gallery-open">
                            <img class="mc-product-gallery__main" src="{{ thumb }}" alt="{{ heading_title }}"{% if thumb_width %} width="{{ thumb_width }}"{% endif %}{% if thumb_height %} height="{{ thumb_height }}"{% endif %}>
                        </a>

                        {% if images %}
                            <ul class="mc-product-gallery__thumbs">
                                <li>
                                    <a
                                        class="mc-product-gallery__thumb is-active"
                                        href="{{ popup }}"
                                        data-mc-action="gallery-thumb"
                                        data-mc-gallery-src="{{ thumb }}"
                                        data-mc-gallery-alt="{{ heading_title }}"
                                    >
                                        <img class="mc-product-gallery__thumb-image" src="{{ thumb }}" alt="" loading="lazy"{% if thumb_width %} width="{{ thumb_width }}"{% endif %}{% if thumb_height %} height="{{ thumb_height }}"{% endif %}>
                                    </a>
                                </li>
                                {% for image in images %}
                                    <li>
                                        <a
                                            class="mc-product-gallery__thumb"
                                            href="{{ image.popup }}"
                                            data-mc-action="gallery-thumb"
                                            data-mc-gallery-src="{{ image.thumb }}"
                                            data-mc-gallery-alt="{{ heading_title }}"
                                        >
                                            <img class="mc-product-gallery__thumb-image" src="{{ image.thumb }}" alt="" loading="lazy"{% if image.thumb_width %} width="{{ image.thumb_width }}"{% endif %}{% if image.thumb_height %} height="{{ image.thumb_height }}"{% endif %}>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>

                <div class="col-md-7">
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="mc-product-card__action-button" data-mc-action="toggle-wishlist" data-product-id="{{ product_id }}" data-mc-text-wishlist-error="{{ text_wishlist_error }}" aria-pressed="false" aria-label="{{ text_wishlist }}">♥</button>
                        <button type="button" class="mc-product-card__action-button" data-mc-action="toggle-compare" data-product-id="{{ product_id }}" aria-pressed="false" aria-label="{{ text_compare }}">⇄</button>
                    </div>

                    <h1 class="mb-2">{{ heading_title }}</h1>

                    {% if review_status and rating %}
                        <a class="mc-product-page__rating-link mb-3" href="{{ section_url }}#product-reviews" data-mc-action="scroll-to-section">
                            <span class="mc-rating" style="--mc-rating-value: {{ (rating / 5 * 100)|round }}%" role="img" aria-label="{{ text_rated|format(rating) }}">
                                <span class="mc-rating__stars" aria-hidden="true">
                                    <span class="mc-rating__stars-empty">★★★★★</span>
                                    <span class="mc-rating__stars-filled">★★★★★</span>
                                </span>
                            </span>
                            <span>{{ tab_review }}</span>
                        </a>
                    {% endif %}

                    <ul class="list-unstyled mb-3">
                        {% if manufacturer %}
                            <li>{{ text_manufacturer }} <a href="{{ manufacturers }}">{{ manufacturer }}</a></li>
                        {% endif %}
                        <li>{{ text_model }} {{ model }}</li>
                        {% if reward %}
                            <li>{{ text_reward }} {{ reward }}</li>
                        {% endif %}
                        <li>{{ text_stock }} <span class="mc-stock {{ mc_in_stock ? 'mc-stock--in' : 'mc-stock--out' }}">{{ stock }}</span></li>
                    </ul>

                    {% if price %}
                        {# product-price.js turns this into the live total for the
                           chosen quantity + options (route mintcart/price). #}
                        <div class="mc-price mc-price--lg mb-3{% if special %} mc-price--special{% endif %}" data-mc-product-price data-mc-product-id="{{ product_id }}" aria-live="polite">
                            <span class="mc-price__current" data-mc-price-current>{{ special ?: price }}</span>
                            <span class="mc-price__original" data-mc-price-original{% if not special %} hidden{% endif %}>{{ special ? price }}</span>
                            {% if tax %}<span class="mc-price__tax d-block">{{ text_tax }} <span data-mc-price-tax>{{ tax }}</span></span>{% endif %}
                        </div>

                        {% if points %}
                            <p>{{ text_points }} {{ points }}</p>
                        {% endif %}

                        {% if discounts %}
                            <ul class="list-unstyled mb-3">
                                {% for discount in discounts %}
                                    <li>{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endif %}

                    {% if options %}
                        <p class="mc-product-page__options-title">{{ text_option }}</p>
                        <div data-mc-product-options>
                            {% for option in options %}
                                <div class="mc-field mb-3">
                                    {% if option.type == 'select' %}
                                        <label class="mc-field__label" for="input-option-{{ option.product_option_id }}">{{ option.name }}{% if option.required %} *{% endif %}</label>
                                        <select id="input-option-{{ option.product_option_id }}" name="option[{{ option.product_option_id }}]" class="mc-field__control" data-mc-option-id="{{ option.product_option_id }}">
                                            <option value="">{{ text_select|trim }}</option>
                                            {% for value in option.product_option_value %}
                                                <option value="{{ value.product_option_value_id }}">{{ value.name }}{% if value.price %} ({{ value.price_prefix }}{{ value.price }}){% endif %}</option>
                                            {% endfor %}
                                        </select>
                                    {% elseif option.type == 'radio' %}
                                        <fieldset class="mc-choice-group">
                                            <legend class="mc-field__label">{{ option.name }}{% if option.required %} *{% endif %}</legend>
                                            {% for value in option.product_option_value %}
                                                <label class="mc-radio">
                                                    <input type="radio" class="mc-radio__input" name="option[{{ option.product_option_id }}]" value="{{ value.product_option_value_id }}" data-mc-option-id="{{ option.product_option_id }}">
                                                    <span class="mc-radio__label">{{ value.name }}{% if value.price %} ({{ value.price_prefix }}{{ value.price }}){% endif %}</span>
                                                </label>
                                            {% endfor %}
                                        </fieldset>
                                    {% elseif option.type == 'checkbox' %}
                                        <fieldset class="mc-choice-group">
                                            <legend class="mc-field__label">{{ option.name }}{% if option.required %} *{% endif %}</legend>
                                            {% for value in option.product_option_value %}
                                                <label class="mc-checkbox">
                                                    <input type="checkbox" class="mc-checkbox__input" name="option[{{ option.product_option_id }}][]" value="{{ value.product_option_value_id }}" data-mc-option-id="{{ option.product_option_id }}">
                                                    <span class="mc-checkbox__label">{{ value.name }}{% if value.price %} ({{ value.price_prefix }}{{ value.price }}){% endif %}</span>
                                                </label>
                                            {% endfor %}
                                        </fieldset>
                                    {% elseif option.type == 'textarea' %}
                                        <label class="mc-field__label" for="input-option-{{ option.product_option_id }}">{{ option.name }}{% if option.required %} *{% endif %}</label>
                                        <textarea id="input-option-{{ option.product_option_id }}" name="option[{{ option.product_option_id }}]" class="mc-field__control" rows="3" data-mc-option-id="{{ option.product_option_id }}">{{ option.value }}</textarea>
                                    {% elseif option.type == 'file' %}
                                        <label class="mc-field__label" for="input-option-{{ option.product_option_id }}">{{ option.name }}{% if option.required %} *{% endif %}</label>
                                        <input type="file" id="input-option-{{ option.product_option_id }}" class="mc-field__control" data-mc-option-upload="{{ option.product_option_id }}" aria-describedby="input-option-{{ option.product_option_id }}-status">
                                        <input type="hidden" name="option[{{ option.product_option_id }}]" value="" data-mc-option-id="{{ option.product_option_id }}">
                                        <p class="mc-field__help" id="input-option-{{ option.product_option_id }}-status" aria-live="polite"></p>
                                    {% else %}
                                        <label class="mc-field__label" for="input-option-{{ option.product_option_id }}">{{ option.name }}{% if option.required %} *{% endif %}</label>
                                        <input type="{{ option.type in ['date', 'time', 'datetime'] ? option.type : 'text' }}" id="input-option-{{ option.product_option_id }}" name="option[{{ option.product_option_id }}]" value="{{ option.value }}" class="mc-field__control" data-mc-option-id="{{ option.product_option_id }}">
                                    {% endif %}
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="mc-quantity">
                            <button type="button" class="mc-quantity__button" data-mc-action="quantity-decrement" aria-label="Decrease quantity">−</button>
                            <input type="number" id="input-quantity" class="mc-quantity__input" name="quantity" value="{{ minimum }}" min="{{ minimum }}" step="1" inputmode="numeric" aria-label="{{ entry_qty }}">
                            <button type="button" class="mc-quantity__button" data-mc-action="quantity-increment" aria-label="Increase quantity">+</button>
                        </div>

                        <button
                            type="button"
                            class="mc-button mc-button--primary"
                            data-mc-action="add-to-cart"
                            data-product-id="{{ product_id }}"
                            data-product-name="{{ heading_title }}"
                            data-quantity-input="input-quantity"
                            data-mc-cart-url="{{ cart_url }}"
                            data-mc-text-view-cart="{{ text_view_cart }}"
                            data-mc-text-added="{{ text_added_to_cart }}"
                            data-mc-text-add-error="{{ text_add_to_cart_error }}"
                            {{ price is same as(false) ? 'disabled' : '' }}
                        >
                            {{ text_add_to_cart }}
                        </button>
                    </div>

                    {% if minimum > 1 %}
                        <p class="mc-field__help mt-2">{{ text_minimum }}</p>
                    {% endif %}

                    {# Delivery / payment / returns, from the store's enabled
                       extensions and Return Terms page (mintcart/purchase_info). #}
                    {% if mc_purchase_info.delivery or mc_purchase_info.payment or mc_purchase_info.returns %}
                        <dl class="mc-purchase-info mt-4">
                            {% if mc_purchase_info.delivery %}
                                <div class="mc-purchase-info__row">
                                    <dt class="mc-purchase-info__label">{{ text_mc_delivery }}</dt>
                                    <dd class="mc-purchase-info__value">{{ mc_purchase_info.delivery|join(' · ') }}</dd>
                                </div>
                            {% endif %}
                            {% if mc_purchase_info.payment %}
                                <div class="mc-purchase-info__row">
                                    <dt class="mc-purchase-info__label">{{ text_mc_payment }}</dt>
                                    <dd class="mc-purchase-info__value">{{ mc_purchase_info.payment|join(' · ') }}</dd>
                                </div>
                            {% endif %}
                            {% if mc_purchase_info.returns %}
                                <div class="mc-purchase-info__row">
                                    <dt class="mc-purchase-info__label">{{ text_mc_returns }}</dt>
                                    <dd class="mc-purchase-info__value"><a href="{{ mc_purchase_info.returns.href }}">{{ mc_purchase_info.returns.title }}</a></dd>
                                </div>
                            {% endif %}
                        </dl>
                    {% endif %}
                </div>
            </div>

            {% if description %}
                <div class="mc-product-section" id="product-description" data-mc-section>
                    <p class="mc-product-section__title">{{ tab_description }}</p>
                    <div class="mc-prose">
                        {{ description|raw }}
                    </div>
                </div>
            {% endif %}

            {% if attribute_groups %}
                <div class="mc-product-section" id="product-specs" data-mc-section>
                    <p class="mc-product-section__title">{{ tab_attribute }}</p>
                    {% for attribute_group in attribute_groups %}
                        <p class="mc-product-section__subtitle">{{ attribute_group.name }}</p>
                        <table class="table table-striped">
                            <tbody>
                                {% for attribute in attribute_group.attribute %}
                                    <tr>
                                        <td>{{ attribute.name }}</td>
                                        <td>{{ attribute.text }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endfor %}
                </div>
            {% endif %}

            {% if review_status %}
                <div class="mc-product-section" id="product-reviews" data-mc-section>
                    <p class="mc-product-section__title">{{ tab_review }}</p>
                    <div class="mc-reviews" data-mc-reviews data-mc-reviews-product-id="{{ product_id }}">
                        <div class="mc-reviews__list" data-mc-reviews-list aria-live="polite">
                            <p class="mc-reviews__empty">{{ text_no_reviews }}</p>
                        </div>

                        <div class="mc-reviews__form-wrapper">
                            <p class="mc-reviews__form-title">{{ text_write }}</p>

                            {% if review_guest %}
                                <form class="mc-reviews__form" data-mc-reviews-form novalidate>
                                    <div class="mc-field mb-3">
                                        <label class="mc-field__label" for="input-review-name">{{ entry_name }}</label>
                                        <input type="text" name="name" value="{{ customer_name }}" id="input-review-name" class="mc-field__control" required minlength="3" maxlength="25">
                                    </div>

                                    <div class="mc-field mb-3">
                                        <label class="mc-field__label" for="input-review-text">{{ entry_review }}</label>
                                        <textarea name="text" rows="5" id="input-review-text" class="mc-field__control" required minlength="25" maxlength="1000"></textarea>
                                        <p class="mc-field__help">{{ text_note|raw }}</p>
                                    </div>

                                    <fieldset class="mc-rating-input mb-3">
                                        <legend class="mc-field__label">{{ entry_rating }}</legend>
                                        <div class="mc-rating-input__stars">
                                            {% for value in [5, 4, 3, 2, 1] %}
                                                <input type="radio" class="mc-rating-input__control visually-hidden" name="rating" id="input-review-rating-{{ value }}" value="{{ value }}" required>
                                                <label class="mc-rating-input__star" for="input-review-rating-{{ value }}">
                                                    <span class="visually-hidden">
                                                        {% if value == 1 %}1 - {{ entry_bad }}{% elseif value == 5 %}5 - {{ entry_good }}{% else %}{{ value }}{% endif %}
                                                    </span>
                                                    <span aria-hidden="true">★</span>
                                                </label>
                                            {% endfor %}
                                        </div>
                                    </fieldset>

                                    {% if captcha %}
                                        <div class="mc-field mb-3">{{ captcha|raw }}</div>
                                    {% endif %}

                                    <div data-mc-reviews-message></div>

                                    <button type="submit" class="mc-button mc-button--primary" data-mc-reviews-submit>{{ button_continue }}</button>
                                </form>
                            {% else %}
                                <p>{{ text_login|raw }}</p>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if tags %}
                <p class="mb-4">
                    {{ text_tags }}
                    {% for tag in tags %}
                        <a href="{{ tag.href }}">{{ tag.tag }}</a>{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </p>
            {% endif %}

            {% if product_cards %}
                <div class="mc-product-section" id="product-related" data-mc-section>
                    <p class="mc-product-section__title">{{ text_related }}</p>
                    <div class="row g-4">
                        {% for product_card in product_cards %}
                            <div class="col-6 col-lg-3">
                                {{ product_card }}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="mc-viewed-products" data-mc-viewed-products data-mc-viewed-products-exclude="{{ product_id }}" hidden>
                <h2 class="h4 mb-3">{{ text_viewed }}</h2>
                <div class="row g-4" data-mc-viewed-products-list></div>
            </div>

            {{ content_bottom }}
        </div>

        {{ column_right }}
    </div>
</div>
{% if price %}
    {# Sticky buy bar (buy-bar.js): shown once the main Add to Cart button has
       scrolled out of view; its button clicks the real one, so options,
       quantity, toasts and missing-option marking all stay in one place. #}
    <div class="mc-buy-bar" data-mc-buy-bar role="region" aria-label="{{ heading_title }}" hidden>
        <div class="container mc-buy-bar__inner">
            {% if thumb %}<img class="mc-buy-bar__thumb" src="{{ thumb }}" alt="" width="48" height="48" loading="lazy">{% endif %}
            <div class="mc-buy-bar__info">
                <p class="mc-buy-bar__name">{{ heading_title }}</p>
                <p class="mc-buy-bar__price{% if special %} mc-buy-bar__price--special{% endif %}" data-mc-price-current>{{ special ?: price }}</p>
            </div>
            <button type="button" class="mc-button mc-button--primary mc-buy-bar__button" data-mc-action="buy-bar-add">{{ text_add_to_cart }}</button>
        </div>
    </div>
{% endif %}
{{ footer }}
