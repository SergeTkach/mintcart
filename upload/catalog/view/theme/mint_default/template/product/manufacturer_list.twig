{{ header }}
<div class="container py-4">
    <nav class="mc-breadcrumb mb-4" aria-label="Breadcrumb">
        <ol class="mc-breadcrumb__list">
            {% for breadcrumb in breadcrumbs %}
                {% if not loop.last %}
                    <li class="mc-breadcrumb__item">
                        <a class="mc-breadcrumb__link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                    </li>
                {% else %}
                    <li class="mc-breadcrumb__item" aria-current="page">{{ breadcrumb.text }}</li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    <div class="row g-4">
        {{ column_left }}

        {% if column_left and column_right %}
            {% set content_class = 'col-lg-6' %}
        {% elseif column_left or column_right %}
            {% set content_class = 'col-lg-9' %}
        {% else %}
            {% set content_class = 'col-12' %}
        {% endif %}

        <div class="{{ content_class }}">
            {{ content_top }}

            <h1 class="mb-4">{{ heading_title }}</h1>

            {% if categories %}
                <p class="mb-4">
                    <strong>{{ text_index }}</strong>
                    {% for category in categories %}
                        <a class="mc-button mc-button--ghost mc-button--sm" href="#letter-{{ category.name }}">{{ category.name }}</a>
                    {% endfor %}
                </p>

                {% for category in categories %}
                    <div id="letter-{{ category.name }}" class="mb-4">
                        <p class="fw-semibold h5 mb-3">{{ category.name }}</p>

                        {% if category.manufacturer %}
                            <div class="row g-3">
                                {% for manufacturer in category.manufacturer %}
                                    <div class="col-6 col-md-4 col-lg-3">
                                        <a class="mc-button mc-button--secondary w-100" href="{{ manufacturer.href }}">{{ manufacturer.name }}</a>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            {% else %}
                <p>{{ text_no_results }}</p>
                <div class="text-end">
                    <a href="{{ continue }}" class="mc-button mc-button--primary">{{ button_continue }}</a>
                </div>
            {% endif %}

            {{ content_bottom }}
        </div>

        {{ column_right }}
    </div>
</div>
{{ footer }}
