{{ header }}
<div class="container py-4">
    <nav class="mc-breadcrumb mb-4" aria-label="Breadcrumb">
        <ol class="mc-breadcrumb__list">
            {% for breadcrumb in breadcrumbs %}
                {% if not loop.last %}
                    <li class="mc-breadcrumb__item">
                        <a class="mc-breadcrumb__link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                    </li>
                {% else %}
                    <li class="mc-breadcrumb__item" aria-current="page">{{ breadcrumb.text }}</li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    <div class="mc-order-success">
        <span class="mc-order-success__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
        </span>
        <h1 class="mc-order-success__title">{{ heading_title }}</h1>
        <div class="mc-order-success__text mc-prose">{{ text_message }}</div>
        <a class="mc-button mc-button--primary mc-button--lg" href="{{ continue }}">{{ button_continue }}</a>
    </div>
</div>
{{ footer }}
