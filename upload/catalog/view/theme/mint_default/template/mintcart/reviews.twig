{{ header }}
<div class="container py-4">
    <nav class="mc-breadcrumb mb-4" aria-label="Breadcrumb">
        <ol class="mc-breadcrumb__list">
            {% for breadcrumb in breadcrumbs %}
                {% if not loop.last %}
                    <li class="mc-breadcrumb__item">
                        <a class="mc-breadcrumb__link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
                    </li>
                {% else %}
                    <li class="mc-breadcrumb__item" aria-current="page">{{ breadcrumb.text }}</li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    <div class="row g-4">
        {{ column_left }}

        {% if column_left and column_right %}
            {% set content_class = 'col-lg-6' %}
        {% elseif column_left or column_right %}
            {% set content_class = 'col-lg-9' %}
        {% else %}
            {% set content_class = 'col-12' %}
        {% endif %}

        <div class="{{ content_class }}">
            {{ content_top }}

            <h1 class="mb-4">{{ heading_title }}</h1>

            {% if reviews %}
                <div class="mc-reviews">
                    {% for review in reviews %}
                        <article class="mc-reviews__item">
                            <header class="mc-reviews__item-header">
                                <strong class="mc-reviews__author">{{ review.author }}</strong>
                                <span class="mc-reviews__date">{{ review.date_added }}</span>
                            </header>

                            <div class="mc-rating mc-rating--sm" style="--mc-rating-value: {{ (review.rating / 5 * 100)|round }}%" role="img" aria-label="{{ text_rated|format(review.rating) }}">
                                <span class="mc-rating__stars" aria-hidden="true">
                                    <span class="mc-rating__stars-empty">★★★★★</span>
                                    <span class="mc-rating__stars-filled">★★★★★</span>
                                </span>
                            </div>

                            <p class="mc-reviews__text">{{ review.text }}</p>
                            <p class="mc-reviews__text">{{ text_about }} <a href="{{ review.product_href }}">{{ review.product_name }}</a></p>
                        </article>
                    {% endfor %}

                    <div class="mc-reviews__pagination">
                        <div class="mc-reviews__pagination-links">{{ pagination }}</div>
                        <p class="mc-reviews__pagination-summary">{{ results }}</p>
                    </div>
                </div>
            {% else %}
                <p class="mc-reviews__empty">{{ text_empty }}</p>
            {% endif %}

            {{ content_bottom }}
        </div>

        {{ column_right }}
    </div>
</div>
{{ footer }}
