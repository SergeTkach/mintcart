{#
    Slideshow module on mint_default: hero slider on Swiper 14 (slider.js,
    preset "hero"). Same banners[] (title, link, image) as the stock
    ControllerExtensionModuleSlideshow. mc-slider__* classes, not swiper-*,
    so the stock controller's Swiper 3 CSS never touches it.
    Contract: docs/developer/components/slider.md
#}
{% if banners %}
<div class="mc-slider mc-slider--hero mb-4" data-mc-slider="hero">
    <div class="mc-slider__viewport">
        <div class="mc-slider__track">
            {% for banner in banners %}
                <div class="mc-slider__slide">
                    {% if banner.link %}<a class="mc-slider__link" href="{{ banner.link }}">{% endif %}
                    <img class="mc-slider__image" src="{{ banner.image }}" alt="{{ banner.title }}"{% if not loop.first %} loading="lazy"{% endif %}>
                    {% if banner.link %}</a>{% endif %}
                </div>
            {% endfor %}
        </div>
    </div>
    {% if banners|length > 1 %}
        <button type="button" class="mc-slider__arrow mc-slider__arrow--prev" data-mc-slider-prev aria-label="Previous slide">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0"/></svg>
        </button>
        <button type="button" class="mc-slider__arrow mc-slider__arrow--next" data-mc-slider-next aria-label="Next slide">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708"/></svg>
        </button>
        <div class="mc-slider__dots" data-mc-slider-dots></div>
    {% endif %}
</div>
{% endif %}
