{% if title or body or image %}
<section class="mc-block" data-mc-block-type="text-image">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-12{% if image %} col-md-6{% endif %}">
                {% if title %}
                    <h2 class="mc-block__title">{{ title }}</h2>
                {% endif %}

                {% if body %}
                    <div class="mc-prose">{{ body }}</div>
                {% endif %}
            </div>

            {% if image %}
                <div class="col-12 col-md-6{% if image_position == 'left' %} order-md-first{% endif %}">
                    <img
                        src="{{ image }}"
                        alt="{{ image_alt }}"
                        class="mc-block__text-image-media"
                        {% if image_width %}width="{{ image_width }}"{% endif %}
                        {% if image_height %}height="{{ image_height }}"{% endif %}
                        loading="lazy"
                    >
                </div>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
