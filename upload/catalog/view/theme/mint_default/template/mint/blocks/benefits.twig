{% if items %}
<section class="mc-block" data-mc-block-type="benefits">
    <div class="container">
        {% if title %}
            <h2 class="mc-block__title">{{ title }}</h2>
        {% endif %}

        <div class="row g-4">
            {% for item in items %}
                <div class="col-6 col-lg-3">
                    <div class="mc-benefit">
                        <span class="mc-benefit__icon" data-mc-icon="{{ item.icon }}" aria-hidden="true">{{ item.svg }}</span>
                        <h3 class="mc-benefit__title">{{ item.title }}</h3>
                        {% if item.description %}
                            <p class="mc-benefit__description">{{ item.description }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
