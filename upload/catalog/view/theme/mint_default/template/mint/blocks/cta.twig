{% if title or text or (cta_label and cta_url) %}
<section class="mc-block" data-mc-block-type="cta">
    <div class="container">
        <div class="mc-block__cta-inner">
            {% if title %}
                <h2 class="mc-block__title">{{ title }}</h2>
            {% endif %}

            {% if text %}
                <p class="mc-block__cta-text">{{ text }}</p>
            {% endif %}

            {% if cta_label and cta_url %}
                <a class="mc-button mc-button--primary" href="{{ cta_url }}">{{ cta_label }}</a>
            {% endif %}
        </div>
    </div>
</section>
{% endif %}
