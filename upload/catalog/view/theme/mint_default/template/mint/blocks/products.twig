{% if product_cards %}
<section class="mc-block" data-mc-block-type="products">
    <div class="container">
        {% if title %}
            <h2 class="mc-block__title">{{ title }}</h2>
        {% endif %}

        <div class="row g-4">
            {% for product_card in product_cards %}
                <div class="col-6 col-md-4 col-lg-3">
                    {{ product_card }}
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}
