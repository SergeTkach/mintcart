{{ header }}
<div class="container py-4">
    <nav class="mc-breadcrumb mb-4" aria-label="Breadcrumb">
        <ol class="mc-breadcrumb__list">
            {% for breadcrumb in breadcrumbs %}
                {% if not loop.last %}
                    <li class="mc-breadcrumb__item"><a class="mc-breadcrumb__link" href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% else %}
                    <li class="mc-breadcrumb__item" aria-current="page">{{ breadcrumb.text }}</li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>

    <div class="mc-account">
    {% if success %}
        <div class="mc-alert mc-alert--success mb-3" role="status"><div class="mc-alert__body"><p class="mc-alert__message">{{ success }}</p></div></div>
    {% endif %}
    {% if error_warning %}
        <div class="mc-alert mc-alert--danger mb-3" role="alert"><div class="mc-alert__body"><p class="mc-alert__message">{{ error_warning }}</p></div></div>
    {% endif %}
        <h1 class="mc-account__heading">{{ heading_title }}</h1>
        {% if downloads %}
            <div class="mc-account__card mc-account__card--flush">
                <div class="table-responsive"><table class="mc-table">
                    <thead><tr>
                        <th>{{ column_order_id }}</th>
                        <th>{{ column_name }}</th>
                        <th>{{ column_size }}</th>
                        <th>{{ column_date_added }}</th>
                        <th></th>
                    </tr></thead>
                    <tbody>
                        {% for row in downloads %}
                            <tr>
                                <td data-label="{{ column_order_id }}">{{ row.order_id }}</td>
                                <td data-label="{{ column_name }}">{{ row.name }}</td>
                                <td data-label="{{ column_size }}">{{ row.size }}</td>
                                <td data-label="{{ column_date_added }}">{{ row.date_added }}</td>
                                <td data-label="{{ button_download }}"><a class="mc-button mc-button--primary mc-button--sm" href="{{ row.href }}">{{ button_download }}</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table></div>
            </div>
        {% if pagination %}
            <div class="mc-account__pager"><div>{{ pagination }}</div><div class="mc-account__results">{{ results }}</div></div>
        {% endif %}
        {% else %}
            <p class="mc-account__empty">{{ text_empty }}</p>
        {% endif %}
        <div class="mc-account__actions mc-account__actions--end">
            <a class="mc-button mc-button--primary" href="{{ continue }}">{{ button_continue }}</a>
        </div>
    </div>
    {{ content_bottom }}
</div>
{{ footer }}
