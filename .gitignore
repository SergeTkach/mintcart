# OS
.DS_Store
Thumbs.db

# Editors
/.idea/
/.vscode/

# Env / secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
vendor/

# MintCart frontend build output (generated by `npm run build` / `npm run dev`)
assets/dist/

# Local-dev copy of the build output inside the OpenCart docroot, so
# assets/dist/{css,js} is actually reachable by URL (assets/ lives outside
# upload/, which is what Laragon/Apache serves) - not a source file, just a
# dev-time copy of the ignored assets/dist/ above. The real deploy-time
# answer is the release packaging script (docs/IMPLEMENTATION_STATUS.md
# Phase 11 (Technical Plan) - Update/Compatibility, still TODO).
upload/assets/

# Scratch
/temp/

# MintCart / OpenCart runtime (upload/)
upload/**/.htaccess
upload/**/config.php
upload/**/install.lock
upload/**/test*
# ...except the real, source-controlled Theme API milestone-proof theme
# (docs/IMPLEMENTATION_STATUS.md Phase 8) - not runtime/scratch test data.
!upload/catalog/view/theme/test_theme/
!upload/catalog/view/theme/test_theme/**
upload/shop/*
upload/storage/*

upload/catalog/view/data/*
!upload/catalog/view/data/index.html

upload/catalog/view/html/*
!upload/catalog/view/html/index.html

upload/image/cache/*
!upload/image/cache/index.html

upload/system/storage/*
!upload/system/storage/backup/
upload/system/storage/backup/*
!upload/system/storage/backup/index.html

upload/system/storage/cache/*
!upload/system/storage/cache/index.html

upload/system/storage/download/*
!upload/system/storage/download/index.html

upload/system/storage/logs/*
!upload/system/storage/logs/index.html

upload/system/storage/session/*
!upload/system/storage/session/index.html

