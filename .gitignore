# OS
.DS_Store
Thumbs.db

# Editors
/.idea/
/.vscode/

# Env / secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
vendor/

# MintCart frontend build output (generated by `npm run build` / `npm run dev`)
assets/dist/

# Local-dev copy of the build output inside the OpenCart docroot, so
# assets/dist/{css,js} is actually reachable by URL (assets/ lives outside
# upload/, which is what Laragon/Apache serves) - not a source file, just a
# dev-time copy of the ignored assets/dist/ above. The real deploy-time
# answer is the release packaging script (docs/IMPLEMENTATION_STATUS.md
# Phase 11 (Technical Plan) - Update/Compatibility, still TODO).
upload/assets/

# Scratch
/temp/

# Release packaging output (scripts/release.js — npm run release)
/release/

# MintCart / OpenCart runtime (upload/)
upload/**/.htaccess
upload/**/config.php
upload/**/install.lock
upload/**/test*
# ...except the real, source-controlled Theme API milestone-proof theme
# (docs/IMPLEMENTATION_STATUS.md Phase 8) - not runtime/scratch test data.
!upload/catalog/view/theme/test_theme/
!upload/catalog/view/theme/test_theme/**
# ...and except the real, source-controlled Testimonials block source files
# (docs/IMPLEMENTATION_STATUS.md Phase 10) - the broad test* glob above
# matches these only because their filename happens to start with "test",
# same false-positive class the test_theme/ negation above already fixed
# once (see that commit's message).
!upload/system/library/mintcart/blocks/testimonialsblockprovider.php
!upload/catalog/view/theme/mint_default/template/mint/blocks/testimonials.twig
# ...and except OpenCart's own core `Config` engine class
# (`upload/system/library/config.php`) - the installer-generated
# `upload/config.php`/`upload/admin/config.php` DB-credential files are the
# only `config.php` this rule is meant to keep out of source control; the
# broad `upload/**/config.php` glob above swept up this stock framework
# class file too, the same false-positive class the two negations above
# already fixed twice for `test_theme/`/`test*`. Its absence meant every
# request would fatal on `new Config()` in `system/framework.php` - see
# `docs/fixes/registry.md` for the fix entry.
!upload/system/library/config.php
upload/shop/*
upload/storage/*

upload/catalog/view/data/*
!upload/catalog/view/data/index.html

upload/catalog/view/html/*
!upload/catalog/view/html/index.html

upload/image/cache/*
!upload/image/cache/index.html

upload/system/storage/*
!upload/system/storage/backup/
upload/system/storage/backup/*
!upload/system/storage/backup/index.html

upload/system/storage/cache/*
!upload/system/storage/cache/index.html

upload/system/storage/download/*
!upload/system/storage/download/index.html

upload/system/storage/logs/*
!upload/system/storage/logs/index.html

upload/system/storage/session/*
!upload/system/storage/session/index.html

# Backups
*.zip

# Logos uploaded through the Setup Wizard (store data, not source)
upload/image/catalog/logo-*

# Local-only demo photos (build_local_electronics.py): third-party shop photos, never commit.
upload/image/catalog/products/
upload/image/catalog/local/
